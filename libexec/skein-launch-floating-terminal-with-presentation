#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Launch a floating terminal with the Skein presentation wrapper

if (($# == 0)); then
  echo "Usage: skein-launch-floating-terminal-with-presentation <command>" >&2
  exit 1
fi

cmd="$*"
exec setsid uwsm-app -S both -- xdg-terminal-exec --app-id=org.skein.terminal --title=Skein -- bash -c "$(skein_command skein-show-logo); $cmd; status=\$?; if (( status != 130 )); then $(skein_command skein-show-done); fi; exit \"\$status\""
