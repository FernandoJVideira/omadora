#!/bin/bash

# Creates a new Skein migration named after the unix timestamp of the last commit.

cd ~/.local/share/skein || exit 1
migration_file="$HOME/.local/share/skein/migrations/$(git log -1 --format=%cd --date=unix).sh"
touch "$migration_file"

if [[ $1 != "--no-edit" ]]; then
  nvim "$migration_file"
fi

echo "$migration_file"
