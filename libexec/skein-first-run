#!/bin/bash

# Run the first-run scripts and welcome.

set -e

FIRST_RUN_MODE="$HOME/.local/state/skein/first-run.mode"

if [[ -f $FIRST_RUN_MODE ]]; then
  rm -f "$FIRST_RUN_MODE"

  bash "$SKEIN_PATH/install/first-run/gdk-scale.sh"
  bash "$SKEIN_PATH/install/first-run/hyprglass.sh"
  bash "$SKEIN_PATH/install/first-run/welcome.sh"
  bash "$SKEIN_PATH/install/first-run/agent-setup.sh"
fi
