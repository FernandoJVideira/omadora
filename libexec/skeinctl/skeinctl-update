#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../lib/common/init.sh"

# shellcheck source=lib/common/cli.sh
source "$SKEIN_LIB_DIR/common/cli.sh"

# -----------------------------------------------------------------------------
# CLI Definition
# -----------------------------------------------------------------------------

CLI_GROUP="update"
CLI_SUMMARY="Run Skein update functions"
CLI_DEFAULT_COMMAND="all"

CLI_NAMESPACES=()

CLI_COMMANDS=(
  "all||Skein system update all (default)|run_all||"
  "check||Run an Skein system updates check|run_check||"
)

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------

run_all() {
  skein_exec skein-update
}

run_check() {
  skein_exec 'systemd/skein-update-check'
}

# -----------------------------------------------------------------------------
# Completion
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

cli_main "$@"
