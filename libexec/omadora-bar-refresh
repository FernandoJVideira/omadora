#!/bin/bash

# Ask the top bar to re-run status modules: update, weather, idle,
# notification-silencing or screenrecording (Waybar or Quickshell).

declare -A signals=([update]=7 [screenrecording]=8 [idle]=9 [notification-silencing]=10 [weather]=11)

for module in "$@"; do
  if [[ -n ${signals[$module]:-} ]] && pgrep -x waybar >/dev/null; then
    pkill -RTMIN+"${signals[$module]}" waybar
  fi
  if command -v qs >/dev/null; then
    qs -c omadora ipc call bar refresh "$module" >/dev/null 2>&1
  fi
done

exit 0
