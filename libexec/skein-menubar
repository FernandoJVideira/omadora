#!/usr/bin/env bash
set -euo pipefail

# Menu bar settings, kept in ~/.config/skein/shell.json next to the text size (the shell watches the file).
#   skein-menubar get                      print the settings
#   skein-menubar set <key> <json value>   controlCenter, notificationCenter, clockStyle, clock24h, clockSeconds,
#                                          barLayout ({"left":[ids],"center":[ids],"right":[ids]}), barSize,
#                                          barOpacity, barFloating, barBorder, barDensity, showModes
#   skein-menubar apply <json object>      several of those at once (a preset), in one write
#   skein-menubar reset                    back to the classic bar and default items

config="${XDG_CONFIG_HOME:-$HOME/.config}/skein/shell.json"
keys='^(controlCenter|notificationCenter|clockStyle|clock24h|clockSeconds|barLayout|barSize|barOpacity|barFloating|barBorder|barDensity|barStyle|showModes)$'
old_keys='^(showCpu|showBattery|showTray|showUpdates|showAgents)$'
# Not part of the menu bar: kept through a reset and left out of "get"
other_keys='^(notificationSound)$'

read_config() {
  local data='{}'
  [[ -f $config ]] && data="$(jq -ec 'select(type == "object")' "$config" 2>/dev/null || echo '{}')"
  echo "$data"
}

write_config() { # <jq filter> [jq args...]
  local filter="$1"
  shift
  mkdir -p "$(dirname "$config")"
  read_config | jq "$@" "$filter" >"$config.tmp" && mv "$config.tmp" "$config"
}

case "${1:-}" in
get) read_config | jq 'with_entries(select(.key | test("'"$keys"'")))' ;;
set)
  [[ ${2:-} =~ $keys || ${2:-} =~ $other_keys ]] || { echo "Unknown setting: ${2:-}" >&2; exit 1; }
  write_config '.[$k] = $v' --arg k "$2" --argjson v "$3"
  ;;
apply)
  [[ -n ${2:-} ]] && jq -e 'type == "object"' <<<"$2" >/dev/null 2>&1 || { echo "Usage: skein-menubar apply <json object>" >&2; exit 1; }
  write_config '. + ($v | with_entries(select(.key | test($keys))))' --argjson v "$2" --arg keys "$keys"
  ;;
reset) write_config 'with_entries(select((.key | test("'"$keys"'")) or (.key | test("'"$old_keys"'")) | not))' ;;
*)
  echo "Usage: skein-menubar get | set <key> <json> | apply <json> | reset" >&2
  exit 1
  ;;
esac
