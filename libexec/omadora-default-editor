#!/bin/bash

# Set the default editor used by omadora-launch-editor (ported from Omarchy).
#   omadora-default-editor                print the current default (the command that starts it)
#   omadora-default-editor <editor>       nvim, vim, helix, emacs, code or zed

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

here="$(dirname "${BASH_SOURCE[0]}")"
editor_file="$HOME/.local/state/omadora/defaults/editor"
uwsm_default="$HOME/.config/uwsm/default"

if (($# == 0)); then
  if [[ -f $editor_file ]]; then
    read -r editor <"$editor_file"
  fi
  [[ -n ${editor:-} ]] && echo "$editor" || echo "${EDITOR:-nvim}"
  exit 0
fi

# selection: what you pick; command: what starts it; present: a command that exists once installed
case "$1" in
nvim | neovim) selection="nvim"; command="nvim"; present="nvim"; name="Neovim"; dnf_package="neovim"; glyph= ;;
vim) selection="vim"; command="vim"; present="vim"; name="Vim"; dnf_package="vim-enhanced"; glyph= ;;
helix | hx) selection="helix"; command="hx"; present="hx"; name="Helix"; dnf_package="helix"; glyph= ;;
emacs) selection="emacs"; command="emacs"; present="emacs"; name="Emacs"; dnf_package="emacs"; glyph= ;;
code | vscode) selection="code"; command="flatpak run com.visualstudio.code"; flatpak_id="com.visualstudio.code"; name="VSCode"; glyph= ;;
zed | zeditor) selection="zed"; command="flatpak run dev.zed.Zed"; flatpak_id="dev.zed.Zed"; name="Zed"; glyph= ;;
*)
  echo "Usage: omadora-default-editor <nvim|vim|helix|emacs|code|zed>" >&2
  exit 1
  ;;
esac

if [[ -n ${flatpak_id:-} ]]; then
  flatpak info "$flatpak_id" >/dev/null 2>&1 && have=true || have=false
else
  "$here/omadora-cmd-present" "$present" && have=true || have=false
fi

if [[ $have == false ]]; then
  if [[ $installing == "false" ]]; then
    exec "$here/omadora-launch-floating-terminal-with-presentation" "$here/omadora-default-editor" --install "$selection"
  fi
  if [[ -n ${flatpak_id:-} ]]; then
    flatpak install -y flathub "$flatpak_id" || exit 1
  else
    sudo dnf install -y "$dnf_package" || exit 1
  fi
fi

mkdir -p "$(dirname "$editor_file")"
printf '%s\n' "$command" >"$editor_file"

# Terminal editors also become $EDITOR for the next login, so git and friends follow
case "$selection" in
nvim | vim | helix) [[ -f $uwsm_default ]] && sed -i -E "s|^export EDITOR=.*|export EDITOR=$command|" "$uwsm_default" ;;
esac

"$here/omadora-notification-send" "$glyph" "$name is now the default editor"
