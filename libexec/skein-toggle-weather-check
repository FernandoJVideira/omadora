#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Toggle Weather Checks

readonly flag="weather-check-off"
readonly unit="skein-weather-check.timer"

skein_run skein-toggle "$flag"

if skein_run skein-toggle-enabled "$flag"; then
  systemctl --quiet --user stop "$unit"
  notify-send -u low "    Weather disabled"
else
  systemctl --quiet --user start "$unit"
  notify-send -u low "    Weather enabled"
fi

"$(dirname "${BASH_SOURCE[0]}")/skein-bar-refresh" weather
