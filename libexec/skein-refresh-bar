#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Overwrite the user configs for the top bar with the defaults and restart it.

while IFS= read -r file; do
  skein_run skein-refresh-config "${file#"$SKEIN_ROOT"/config/}"
done < <(find "$SKEIN_ROOT/config/quickshell/skein" -type f | sort)
skein_run skein-restart-bar
