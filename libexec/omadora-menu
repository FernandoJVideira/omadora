show_setup_power_menu() {
  profile=$(menu "Power Profile" "$(omadora_run omadora-powerprofiles-list)" "" "$(powerprofilesctl get)")

  if [[ "$profile" == "CNCLD" || -z "$profile" ]]; then
    back_to show_setup_menu
  else
    omadora_run omadora-powerprofiles-set "$profile"
  fi
}

show_setup_security_menu() {
  case $(menu "Setup" "󰈷  Fingerprint\n  Fido2") in
  *Fingerprint*) present_omadora_terminal omadora-setup-security-fingerprint ;;
  *Fido2*) present_omadora_terminal omadora-setup-security-fido2 ;;
  *) show_setup_menu ;;
  esac
}

show_setup_config_menu() {
  case $(menu "Setup" "  Hyprland\n  Hypridle\n  Hyprsunset\n󰍜  Waybar\n󰞅  XCompose") in
  *Hyprland*) open_in_editor ~/.config/hypr/hyprland.lua ;;
  *Hypridle*) open_in_editor ~/.config/hypr/hypridle.conf && omadora_run omadora-restart-hypridle ;;
  *Hyprsunset*) open_in_editor ~/.config/hypr/hyprsunset.conf && omadora_run omadora-restart-hyprsunset ;;
  *Waybar*) if [[ -f ~/.local/state/omadora/toggles/bar-waybar ]]; then open_in_editor ~/.config/waybar/config.jsonc && omadora_run omadora-restart-waybar; else open_in_editor ~/.config/quickshell/omadora/Bar.qml; fi ;;
  *XCompose*) open_in_editor ~/.XCompose && omadora_run omadora-restart-xcompose ;;
  *) show_setup_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "  Package\n  Flatpak\n  Web App\n  TUI\n  Style") in
  *Package*) terminal "$OMADORA_LIBEXEC_DIR/omadora-pkg-install" ;;
  *Flatpak*) terminal "$OMADORA_LIBEXEC_DIR/omadora-flatpak-install" ;;
  *Web*) present_omadora_terminal omadora-webapp-install ;;
  *TUI*) present_omadora_terminal omadora-tui-install ;;
  *Style*) show_install_style_menu ;;
  *) show_main_menu ;;
  esac
}

show_install_style_menu() {
  case $(menu "Install" "󰸌  Theme\n  Background") in
  *Theme*) present_terminal "$(omadora_command omadora-theme-install) \"\$(gum input --placeholder=\"https://github.com/...\" --header=\"Install user theme from repo URL:\")\"" ;;
  *Background*)
    theme="$(omadora_run omadora-theme-current || true)"
    if [ -z "$theme" ]; then
      notify-send "No active theme" "Set a theme before adding backgrounds"
    else
      dir="$HOME/.config/omadora/backgrounds/$theme"
      mkdir -p "$dir" && nautilus "$dir"
    fi
    ;;
  *) show_install_menu ;;
  esac
}

show_remove_menu() {
  case $(menu "Remove" "  Package\n  Flatpak\n  Web App\n  TUI\n󰸌  Theme\n  Security") in
  *Package*) terminal "$OMADORA_LIBEXEC_DIR/omadora-pkg-remove" ;;
  *Flatpak*) terminal "$OMADORA_LIBEXEC_DIR/omadora-flatpak-remove" ;;
  *Web*) present_omadora_terminal omadora-webapp-remove ;;
  *TUI*) present_omadora_terminal omadora-tui-remove ;;
  *Theme*) present_terminal "$(omadora_command omadora-theme-remove) \"\$($(omadora_command omadora-theme-list-user) | gum choose --header=\"Remove user theme:\")\"" ;;
  *Security*) show_remove_security_menu ;;
  *) show_main_menu ;;
  esac
}

show_remove_security_menu() {
  case $(menu "Remove" "󰈷  Fingerprint\n  Fido2") in
  *Fingerprint*) present_omadora_terminal omadora-remove-security-fingerprint ;;
  *Fido2*) present_omadora_terminal omadora-remove-security-fido2 ;;
  *) show_remove_menu ;;
  esac
}

