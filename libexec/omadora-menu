  case $(menu "Restart" "  Hypridle\n  Hyprsunset\n󰍜  Waybar") in
  *Hypridle*) omadora_run omadora-restart-hypridle ;;
  *Hyprsunset*) omadora_run omadora-restart-hyprsunset ;;
  *Waybar*) omadora_run omadora-restart-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  case $(menu "Use default config" "  Hyprland\n  Hypridle\n  Hyprsunset\n󱣴  Plymouth\n  Tmux\n󰍜  Waybar") in
  *Hyprland*) present_omadora_terminal omadora-refresh-hyprland ;;
  *Hypridle*) present_omadora_terminal omadora-refresh-hypridle ;;
  *Hyprsunset*) present_omadora_terminal omadora-refresh-hyprsunset ;;
  *Plymouth*) present_omadora_terminal omadora-refresh-plymouth ;;
  *Tmux*) present_omadora_terminal omadora-refresh-tmux ;;
  *Waybar*) present_omadora_terminal omadora-refresh-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth") in
  *Audio*) present_omadora_terminal omadora-restart-pipewire ;;
  *Wi-Fi*) present_omadora_terminal omadora-restart-wifi ;;
  *Bluetooth*) present_omadora_terminal omadora-restart-bluetooth ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User") in
  *Drive*) present_omadora_terminal omadora-drive-password ;;
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  omadora_run omadora-launch-about
}

show_system_menu() {
  case $(menu "System" "  Lock\n󱄄  Screensaver\n󰍃  Logout\n󰜉  Reboot\n󰐥  Shutdown") in
  *Lock*) omadora_run omadora-system-lock ;;
  *Screensaver*) omadora_run omadora-launch-screensaver ;;
  *Logout*) omadora_run omadora-system-logout ;;
  *Reboot*) omadora_run omadora-system-reboot ;;
  *Shutdown*) omadora_run omadora-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  local search_file choice
  search_file="$(mktemp)"
  "$OMADORA_LIBEXEC_DIR/omadora-menu-index" >"$search_file" 2>/dev/null

  choice="$(menu "Go" "󰀻  Apps\t›\n󰧑  Learn\t›\n󱓞  Trigger\t›\n  Style\t›\n  Setup\t›\n󰉉  Install\t›\n󰭌  Remove\t›\n  Update\t›\n  About\n  System\t›" "" "" "$search_file")"
  rm -f "$search_file"

  if [[ $choice == @replay:* ]]; then
    # A search result: follow its path through the menus
    local -a steps
    IFS='|' read -r -a steps <<<"${choice#@replay:}"
    REPLAY_FILE="$(mktemp)"
    printf '%s\n' "${steps[@]:1}" >"$REPLAY_FILE"
    go_to_menu "${steps[0]}"
    rm -f "$REPLAY_FILE"
  else
    go_to_menu "$choice"
  fi
}

go_to_menu() {
  case "${1,,}" in
  *apps*) omadora_run omadora-launch-picker --show drun -p "Launch…" ;;
  *learn*) show_learn_menu ;;
  *trigger*) show_trigger_menu ;;
  *toggle*) show_toggle_menu ;;
  *hardware*) show_hardware_menu ;;
  *share*) show_share_menu ;;
  *reminder-set*) show_custom_reminder_input ;;
  *reminder*) show_reminder_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *font*) show_font_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *defaults*) show_defaults_menu ;;
  *agent*) show_default_agent_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/omadora/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
