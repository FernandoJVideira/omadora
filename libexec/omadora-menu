#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Launch the Omadora Menu or takes a parameter to jump straight to a submenu.

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

# Steps still to be picked when a search result is being followed through the menus.
# Kept in a file because menus run inside command substitutions.
REPLAY_FILE=""

# Answer the next menu from the replay steps instead of showing it.
# Prints the matching option, or nothing (after dropping the replay) if it isn't there.
replay_step() {
  local options="$1" step line label

  [[ -s $REPLAY_FILE ]] || return 1
  step="$(head -n1 "$REPLAY_FILE")"
  sed -i 1d "$REPLAY_FILE"

  while IFS= read -r line; do
    label="${line#*  }"
    label="${label%"${label##*[![:space:]]}"}"
    if [[ $label == "$step" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
  done < <(printf '%b\n' "$options")

  : >"$REPLAY_FILE"
  return 1
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="${3:-}"
  local preselect="${4:-}"
  local search_file="${5:-}"
  local -a args=()

  if replay_step "$options"; then
    return
  fi

  read -r -a args <<<"$extra"
  [[ -n $search_file ]] && args+=("--search-extra" "$search_file")

  if [[ -n "$preselect" ]]; then
    local index="" line line_number=0
    while IFS= read -r line; do
      line_number="$((line_number + 1))"
      if [[ "$line" == "$preselect" ]]; then
        index="$line_number"
        break
      fi
    done < <(printf '%b\n' "$options")

    if [[ -n "$index" ]]; then
      args+=("-a" "$index")
    fi
  fi

  printf '%b\n' "$options" | {
    cd "$HOME" || exit 1
    exec "$OMADORA_PATH/libexec/omadora-launch-picker" --dmenu --width 320 -p "$prompt…" "${args[@]}"
  } 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.omadora.terminal "$@"
}

present_terminal() {
  omadora_run omadora-launch-floating-terminal-with-presentation "$1"
}

present_omadora_terminal() {
  omadora_run omadora-launch-floating-terminal-with-presentation "$(omadora_command "$@")"
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  omadora_run omadora-launch-editor "$1"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Omadora\n  Hyprland\n  Fedora\n󰣇  Arch\n  Neovim\n󱆃  Bash\n  Tmux") in
  *Keybindings*) omadora_run omadora-menu-keybindings ;;
  *Omadora*) omadora_run omadora-launch-webapp "https://github.com/elpritchos/omadora" ;;
  *Hyprland*) omadora_run omadora-launch-webapp "https://wiki.hypr.land" ;;
  *Fedora*) omadora_run omadora-launch-webapp "https://docs.fedoraproject.org" ;;
  *Arch*) omadora_run omadora-launch-webapp "https://wiki.archlinux.org" ;;
  *Neovim*) omadora_run omadora-launch-webapp "https://neovim.io/doc/user/quickref.html" ;;
  *Bash*) omadora_run omadora-launch-webapp "https://devhints.io/bash" ;;
  *Tmux*) omadora_run omadora-launch-webapp "https://github.com/tmux/tmux/wiki" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n  Capture\n󰧸  Transcode\n  Share\n󰔎  Toggle\n  Hardware") in
  *Reminder*) show_reminder_menu ;;
  *Capture*) show_capture_menu ;;
  *Transcode*) present_omadora_terminal omadora-transcode ;;
  *Share*) show_share_menu ;;
  *Toggle*) show_toggle_menu ;;
  *Hardware*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) omadora_run omadora-reminder show ;;
  *"Clear all"*) omadora_run omadora-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(
    echo -e '1\n5\n10\n15\n30\n60\n120' |
      omadora_run omadora-launch-picker \
        --dmenu \
        --width 500 \
        --height 240 \
        --prompt "Remind in minutes"
  )

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    omadora_run omadora-notification-send "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(
    echo 'Take a break...' |
      omadora_run omadora-launch-picker \
        --dmenu \
        --width 500 \
        --height 240 \
        --prompt "Reminder message"
  )

  if [[ -n $message ]]; then
    omadora_run omadora-reminder "$minutes" "$message"
  else
    back_to show_reminder_menu
  fi
}

# HACK: Sleeps added to let the picker close before screen capture
show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction\n󰃉  Color") in
  *Screenshot*) sleep 0.1 && omadora_run omadora-capture-screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) sleep 0.1 && omadora_run omadora-capture-text-extraction ;;
  *Color*) sleep 0.1 && pkill hyprpicker || hyprpicker -a ;;
  *) back_to show_trigger_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

# HACK: Sleeps added to let the picker close before screen capture
show_screenrecord_menu() {
  omadora_run omadora-capture-screenrecording --stop-recording && exit 0

  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio\n  With desktop + microphone audio + webcam") in
  *"With no audio") sleep 0.1 && omadora_run omadora-capture-screenrecording ;;
  *"With desktop audio") sleep 0.1 && omadora_run omadora-capture-screenrecording --with-desktop-audio ;;
  *"With desktop + microphone audio") sleep 0.1 && omadora_run omadora-capture-screenrecording --with-desktop-audio --with-microphone-audio ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    sleep 0.1 && omadora_run omadora-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder") in
  *Clipboard*) omadora_run omadora-menu-share clipboard ;;
  *File*) terminal bash -c "$(omadora_command omadora-menu-share file)" ;;
  *Folder*) terminal bash -c "$(omadora_command omadora-menu-share folder)" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  local options="󱄄  Screensaver\n󰔎  Nightlight\n󱫖  Idle Lock\n󰂛  Notifications\n  Weather\n󰍜  Top Bar\n󱂬  Workspace Layout\n  Window Gaps\n  1-Window Ratio\n󰍹  Monitor Scaling\n󱚡  Crash Capture"

  case $(menu "Toggle" "$options") in
  *Screensaver*) omadora_run omadora-toggle-screensaver ;;
  *Nightlight*) omadora_run omadora-toggle-nightlight ;;
  *Idle*) omadora_run omadora-toggle-idle ;;
  *Notifications*) omadora_run omadora-toggle-notification-silencing ;;
  *Weather*) omadora_run omadora-toggle-weather-check ;;
  *Bar*) omadora_run omadora-toggle-waybar ;;
  *Layout*) omadora_run omadora-hyprland-workspace-layout-toggle ;;
  *Ratio*) omadora_run omadora-hyprland-window-single-square-aspect-toggle ;;
  *Gaps*) omadora_run omadora-hyprland-window-gaps-toggle ;;
  *Scaling*) omadora_run omadora-hyprland-monitor-scaling-cycle ;;
  *Crash*) omadora_run omadora-toggle-crash-capture ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_menu() {
  local options="󰛧  Laptop Display\n󰍹  Mirror Display"

  if omadora_run omadora-hw-touchpad; then
    options="$options\n󰟸  Touchpad"
  fi

  if omadora_run omadora-hw-touchscreen; then
    options="$options\n󰆽  Touchscreen"
  fi

  case $(menu "Toggle" "$options") in
  *Laptop*) omadora_run omadora-hyprland-monitor-internal toggle ;;
  *Mirror*) omadora_run omadora-hyprland-monitor-internal-mirror toggle ;;
  *Touchpad*) omadora_run omadora-toggle-touchpad ;;
  *Touchscreen*) omadora_run omadora-toggle-touchscreen ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n  Terminal Font\n  Background\n  Login Screen\n  Hyprland\n󱄄  Screensaver\n  About") in
  *Theme*) show_theme_menu ;;
  *"Terminal Font"*) show_font_menu ;;
  *Background*) qs -c omadora ipc call wallpapers open ;;
  *"Login Screen"*) show_sddm_theme_menu ;;
  *Hyprland*) open_in_editor ~/.config/hypr/looknfeel.lua ;;
  *Screensaver*) show_screensaver_menu ;;
  *About*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_about_menu() {
  case $(menu "About" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) omadora_run omadora-branding-about text ;;
  *Image*) omadora_run omadora-branding-about image ;;
  *Default*) omadora_run omadora-branding-about reset ;;
  *) show_style_menu ;;
  esac
}

show_screensaver_menu() {
  case $(menu "Screensaver" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) omadora_run omadora-branding-screensaver text ;;
  *Image*) omadora_run omadora-branding-screensaver image ;;
  *Default*) omadora_run omadora-branding-screensaver reset ;;
  *) show_style_menu ;;
  esac
}

show_theme_menu() {
  qs -c omadora ipc call themes open
}

show_sddm_theme_menu() {
  local choice
  choice=$(menu "Login Screen" "󰸌  Match Omadora Theme\n$(omadora_run omadora-sddm-theme list)" "--width 350" "$(omadora_run omadora-sddm-theme current)")
  if [[ $choice == "CNCLD" || -z $choice ]]; then
    back_to show_style_menu
  elif [[ $choice == *"Match Omadora Theme"* ]]; then
    present_terminal "$(omadora_command omadora-sddm-theme) set omadora"
  else
    present_terminal "$(omadora_command omadora-sddm-theme) set \"$choice\""
  fi
}

show_font_menu() {
  theme=$(menu "Font" "$(omadora_run omadora-font-list)" "--width 350" "$(omadora_run omadora-font-current)")
  if [[ $theme == "CNCLD" || -z $theme ]]; then
    back_to show_style_menu
  else
    omadora_run omadora-font-set "$theme"
  fi
}

show_setup_menu() {
  local options="  Audio\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n󰍹  Monitors"
  [ -f ~/.config/hypr/bindings.lua ] && options="$options\n  Keybindings"
  [ -f ~/.config/hypr/input.lua ] && options="$options\n󰍽  Input"
  options="$options\n󰱔  DNS\n  Defaults\n  Security\n  Config"

  case $(menu "Setup" "$options") in
  *Audio*) omadora_run omadora-launch-audio ;;
  *Wifi*) omadora_run omadora-launch-wifi ;;
  *Bluetooth*) omadora_run omadora-launch-bluetooth ;;
  *Power*) show_setup_power_menu ;;
  *Monitors*) open_in_editor ~/.config/hypr/monitors.lua ;;
  *Keybindings*) open_in_editor ~/.config/hypr/bindings.lua ;;
  *Input*) open_in_editor ~/.config/hypr/input.lua ;;
  *DNS*) present_omadora_terminal omadora-setup-dns ;;
  *Defaults*) show_defaults_menu ;;
  *Security*) show_setup_security_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

# A list of choices for one default, with the current one marked
# usage: default_menu <title> <current> <entries...>, entries as "<glyph>  <Label>|<value>"
default_menu() {
  local title="$1" current="$2"
  shift 2

  local options="" entry label value
  for entry in "$@"; do
    label="${entry%%|*}"
    value="${entry##*|}"
    options+="$label"
    [[ $value == "$current" ]] && options+="\t✓"
    options+="\n"
  done

  menu "$title" "${options%\\n}"
}

show_defaults_menu() {
  case $(menu "Defaults" "󰚩  Agent\t›\n  Browser\t›\n  Terminal\t›\n  Editor\t›") in
  *Agent*) show_default_agent_menu ;;
  *Browser*) show_default_browser_menu ;;
  *Terminal*) show_default_terminal_menu ;;
  *Editor*) show_default_editor_menu ;;
  *) show_setup_menu ;;
  esac
}

show_default_agent_menu() {
  local choice
  choice=$(default_menu "Default Agent" "$(omadora_run omadora-default-agent)" \
    "󰛄  Claude|claude" "  Codex|codex" "  OpenCode|opencode" "󰫢  Antigravity|agy" "  Copilot|copilot" \
    "󰋑  Crush|crush" "  Grok|grok" "  Cursor CLI|cursor-agent" "󰛤  Muse Code|muse" "󰚩  Pi|pi" "󰚩  Oh My Pi|omp" "󰚩  Ori|ori")
  case "$choice" in
  *Claude*) omadora_run omadora-default-agent claude ;;
  *Codex*) omadora_run omadora-default-agent codex ;;
  *OpenCode*) omadora_run omadora-default-agent opencode ;;
  *Antigravity*) omadora_run omadora-default-agent agy ;;
  *Copilot*) omadora_run omadora-default-agent copilot ;;
  *Crush*) omadora_run omadora-default-agent crush ;;
  *Grok*) omadora_run omadora-default-agent grok ;;
  *Cursor*) omadora_run omadora-default-agent cursor-agent ;;
  *Muse*) omadora_run omadora-default-agent muse ;;
  *"Oh My Pi"*) omadora_run omadora-default-agent omp ;;
  *Pi*) omadora_run omadora-default-agent pi ;;
  *Ori*) omadora_run omadora-default-agent ori ;;
  *) back_to show_defaults_menu ;;
  esac
}

