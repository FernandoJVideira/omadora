#!/bin/bash

# Quickshell login screen on greetd, styled like Omarchy's: skein-greeter [install|sync [--auto]|rollback|status]
#   install   install greetd and cage, deploy the greeter (default/greeter), make greetd the login manager
#             (SDDM on Arch stays installed, just disabled). Takes effect at the next boot.
#   sync      write the colors, user name, logo and main monitor of the active Skein theme into the
#             greeter. "--auto" (run on every theme change) does nothing when the greeter isn't installed.
#   rollback  make the previous login manager the login manager again.
# cage stretches one window over every monitor, so the greeter lays the screens out itself (shell.qml).
set -euo pipefail

SKEIN_PATH="${SKEIN_PATH:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}"
dir=/usr/local/share/skein-greeter
current="${SKEIN_CONFIG_HOME:-$HOME/.config/skein}/current"

if command -v pacman >/dev/null; then
  old_dm=sddm
  install_packages() { sudo pacman -S --needed --noconfirm greetd cage; }
  package_installed() { pacman -Qq "$1" &>/dev/null; }
else
  old_dm=""
  install_packages() { sudo dnf install -y greetd cage; }
  package_installed() { rpm -q "$1" &>/dev/null; }
fi

die() { printf 'skein-greeter: %s\n' "$*" >&2; exit 1; }

sync() {
  local colors="$current/theme/colors.toml"
  color() {
    local value=""
    [[ -f $colors ]] && value=$(sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$colors" | head -n 1)
    printf '%s' "${value:-$2}"
  }

  # the block letters of the logo (its box-drawing frame left out), as a QML string
  local logo="" line
  if [[ -f $SKEIN_PATH/logo.txt ]]; then
    while IFS= read -r line; do
      logo+="${line//\"/}\\n"
    done < <(grep -E '█|▄|▀' "$SKEIN_PATH/logo.txt" | grep -Ev '└|┌')
    logo="${logo%\\n}"
  fi
  [[ -n $logo ]] || logo="SKEIN"

  # the main monitor: the one the generated block of monitors.lua puts at 0x0 (that file is always
  # there, unlike a running Hyprland); hyprctl is the fallback
  local monitors_lua="$HOME/.config/hypr/monitors.lua" primary=""
  [[ -f $monitors_lua ]] && primary=$(sed -n 's/.*\["\([^"]*\)"\][[:space:]]*=[[:space:]]*"0x0".*/\1/p' "$monitors_lua" | head -n 1)
  [[ -n $primary ]] || primary=$(hyprctl -j monitors 2>/dev/null | jq -r '[.[] | select(.x == 0 and .y == 0)][0].name // empty' 2>/dev/null || true)

  # The people who can log in, with their pictures. The greeter runs as its own user and can't read
  # anyone's home, so the pictures are copied (as small PNGs) next to it whenever this runs.
  local users_json="[]" name uid home full shell
  mkdir -p "$dir/avatars"
  rm -f "$dir"/avatars/*.png
  while IFS=: read -r name _ uid _ full home shell; do
    ((uid >= 1000 && uid < 60000)) || continue
    [[ $shell == */nologin || $shell == */false ]] && continue
    local has=false
    if [[ -r $home/.face ]] && command -v magick >/dev/null && magick "$home/.face[0]" -resize 192x192^ -gravity center -extent 192x192 "PNG:$dir/avatars/$name.png" 2>/dev/null; then
      has=true
    fi
    users_json=$(jq -c --arg n "$name" --arg f "${full%%,*}" --argjson a "$has" '. + [{name: $n, fullName: $f, avatar: $a}]' <<<"$users_json")
  done < <(getent passwd)

  cat >"$dir/Theme.qml" <<QML
import QtQuick

QtObject {
  readonly property string user: "$USER"
  readonly property var users: $users_json
  readonly property string primary: "$primary"
  readonly property string logo: "$logo"
  readonly property color background: "$(color background '#1a1b26')"
  readonly property color foreground: "$(color foreground '#c0caf5')"
  readonly property color accent: "$(color accent '#7aa2f7')"
  readonly property color red: "$(color red '#f7768e')"
}
QML
  chmod -R a+rX "$dir"
}

install() {
  echo "Installing greetd and cage..."
  install_packages
  for p in greetd cage quickshell; do package_installed "$p" || die "$p is not installed"; done

  echo "Installing the Quickshell greeter into $dir..."
  sudo install -d -o "$(id -un)" -g "$(id -gn)" "$dir"
  cp "$SKEIN_PATH/default/greeter/shell.qml" "$dir/shell.qml"
  sync

  local greeter_user=greetd
  getent passwd greetd >/dev/null || greeter_user=greeter
  [[ -f /etc/greetd/config.toml && ! -f /etc/greetd/config.toml.skein-backup ]] \
    && sudo cp /etc/greetd/config.toml /etc/greetd/config.toml.skein-backup
  sudo install -d /etc/greetd
  sudo tee /etc/greetd/config.toml >/dev/null <<TOML
[terminal]
vt = 1

[default_session]
command = "cage -s -- env QT_WAYLAND_DISABLE_WINDOWDECORATION=1 quickshell -p $dir"
user = "$greeter_user"
TOML

  # unlock the keyring at login (GNOME Keyring; KWallet is not supported on Arch)
  local pam=/etc/pam.d/greetd module="" lib keyring=${SKEIN_KEYRING:-gnome}
  if [[ $keyring != gnome ]]; then
    echo "WARNING: SKEIN_KEYRING=$keyring is not supported on Arch, using gnome." >&2
  fi
  for lib in /usr/lib64/security /usr/lib/security /usr/lib/x86_64-linux-gnu/security; do
    [[ -f $lib/pam_gnome_keyring.so ]] && { module=gnome; break; }
  done
  if [[ -f $pam ]] && ! sudo grep -qE 'pam_kwallet5|pam_gnome_keyring' "$pam"; then
    case $module in
    gnome) printf '%s\n' 'auth       optional    pam_gnome_keyring.so' 'session    optional    pam_gnome_keyring.so auto_start' | sudo tee -a "$pam" >/dev/null ;;
    *) echo "WARNING: no keyring PAM module found - the keyring will ask for its password after login." >&2 ;;
    esac
  fi

  # the greeter's earlier directories (the dotfiles repo's own, then Omadora's)
  local old
  for old in /usr/local/share/dotfiles-greeter /usr/local/share/omadora-greeter; do
    if [[ -d $old ]]; then sudo rm -rf "$old"; fi
  done
  [[ -n $old_dm ]] && sudo systemctl disable "$old_dm.service" 2>/dev/null || true
  sudo systemctl enable --force greetd.service
  echo "greetd is the login manager from the next boot.${old_dm:+ If the login screen does not show up: Ctrl+Alt+F3, log in, skein-greeter rollback.}"
}

rollback() {
  [[ -n $old_dm ]] || die "there is no previous login manager to go back to"
  package_installed "$old_dm" || die "$old_dm isn't installed, install it first"
  sudo systemctl disable greetd.service 2>/dev/null || true
  sudo systemctl enable --force "$old_dm.service"
  echo "$old_dm is the login manager from the next boot."
}

status() {
  printf 'display manager: %s\n' "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || echo none)"
  for p in greetd cage ${old_dm:+"$old_dm"}; do
    package_installed "$p" && echo "$p installed" || echo "$p missing"
  done
  [[ -n ${XDG_SESSION_ID:-} ]] && printf 'this session came from: %s\n' "$(loginctl show-session "$XDG_SESSION_ID" -p Service --value 2>/dev/null)"
  return 0
}

case "${1:-status}" in
install) install ;;
sync)
  [[ -d $dir && -O $dir && -w $dir ]] || { [[ ${2:-} == --auto ]] && exit 0; die "the greeter isn't installed (skein-greeter install)"; }
  sync
  ;;
rollback) rollback ;;
status) status ;;
*) die "usage: skein-greeter [install|sync [--auto]|rollback|status]" ;;
esac
