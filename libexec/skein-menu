#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Launch the Skein Menu or takes a parameter to jump straight to a submenu.

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

# Steps still to be picked when a search result is being followed through the menus.
# Kept in a file because menus run inside command substitutions.
REPLAY_FILE=""

# Answer the next menu from the replay steps instead of showing it.
# Prints the matching option, or nothing (after dropping the replay) if it isn't there.
replay_step() {
  local options="$1" step line label

  [[ -s $REPLAY_FILE ]] || return 1
  step="$(head -n1 "$REPLAY_FILE")"
  sed -i 1d "$REPLAY_FILE"

  while IFS= read -r line; do
    label="${line#*  }"
    label="${label%"${label##*[![:space:]]}"}"
    if [[ $label == "$step" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
  done < <(printf '%b\n' "$options")

  : >"$REPLAY_FILE"
  return 1
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="${3:-}"
  local preselect="${4:-}"
  local search_file="${5:-}"
  local -a args=()

  if replay_step "$options"; then
    return
  fi

  read -r -a args <<<"$extra"
  [[ -n $search_file ]] && args+=("--search-extra" "$search_file")

  if [[ -n "$preselect" ]]; then
    local index="" line line_number=0
    while IFS= read -r line; do
      line_number="$((line_number + 1))"
      if [[ "$line" == "$preselect" ]]; then
        index="$line_number"
        break
      fi
    done < <(printf '%b\n' "$options")

    if [[ -n "$index" ]]; then
      args+=("-a" "$index")
    fi
  fi

  printf '%b\n' "$options" | {
    cd "$HOME" || exit 1
    exec "$SKEIN_PATH/libexec/skein-launch-picker" --dmenu --width 320 -p "$prompt…" "${args[@]}"
  } 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.skein.terminal "$@"
}

present_terminal() {
  skein_run skein-launch-floating-terminal-with-presentation "$1"
}

present_skein_terminal() {
  skein_run skein-launch-floating-terminal-with-presentation "$(skein_command "$@")"
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  skein_run skein-launch-editor "$1"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Skein\n  Hyprland\n  Fedora\n󰣇  Arch\n  Neovim\n󱆃  Bash\n  Tmux") in
  *Keybindings*) skein_run skein-menu-keybindings ;;
  *Skein*) skein_run skein-launch-webapp "https://github.com/FernandoJVideira/skein" ;;
  *Hyprland*) skein_run skein-launch-webapp "https://wiki.hypr.land" ;;
  *Fedora*) skein_run skein-launch-webapp "https://docs.fedoraproject.org" ;;
  *Arch*) skein_run skein-launch-webapp "https://wiki.archlinux.org" ;;
  *Neovim*) skein_run skein-launch-webapp "https://neovim.io/doc/user/quickref.html" ;;
  *Bash*) skein_run skein-launch-webapp "https://devhints.io/bash" ;;
  *Tmux*) skein_run skein-launch-webapp "https://github.com/tmux/tmux/wiki" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n  Capture\n󰧸  Transcode\n  Share\n  Hardware") in
  *Reminder*) show_reminder_menu ;;
  *Capture*) show_capture_menu ;;
  *Transcode*) present_skein_terminal skein-transcode ;;
  *Share*) show_share_menu ;;
  *Hardware*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) skein_run skein-reminder show ;;
  *"Clear all"*) skein_run skein-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(
    echo -e '1\n5\n10\n15\n30\n60\n120' |
      skein_run skein-launch-picker \
        --dmenu \
        --width 500 \
        --height 240 \
        --prompt "Remind in minutes"
  )

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    skein_run skein-notification-send "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(
    echo 'Take a break...' |
      skein_run skein-launch-picker \
        --dmenu \
        --width 500 \
        --height 240 \
        --prompt "Reminder message"
  )

  if [[ -n $message ]]; then
    skein_run skein-reminder "$minutes" "$message"
  else
    back_to show_reminder_menu
  fi
}

# HACK: Sleeps added to let the picker close before screen capture
show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction\n󰃉  Color") in
  *Screenshot*) sleep 0.1 && skein_run skein-capture-screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) sleep 0.1 && skein_run skein-capture-text-extraction ;;
  *Color*) sleep 0.1 && pkill hyprpicker || hyprpicker -a ;;
  *) back_to show_trigger_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

# HACK: Sleeps added to let the picker close before screen capture
show_screenrecord_menu() {
  skein_run skein-capture-screenrecording --stop-recording && exit 0

  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio\n  With desktop + microphone audio + webcam") in
  *"With no audio") sleep 0.1 && skein_run skein-capture-screenrecording ;;
  *"With desktop audio") sleep 0.1 && skein_run skein-capture-screenrecording --with-desktop-audio ;;
  *"With desktop + microphone audio") sleep 0.1 && skein_run skein-capture-screenrecording --with-desktop-audio --with-microphone-audio ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    sleep 0.1 && skein_run skein-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder") in
  *Clipboard*) skein_run skein-menu-share clipboard ;;
  *File*) terminal bash -c "$(skein_command skein-menu-share file)" ;;
  *Folder*) terminal bash -c "$(skein_command skein-menu-share folder)" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_menu() {
  local options="󰛧  Laptop Display\n󰍹  Mirror Display"

  if skein_run skein-hw-touchscreen; then
    options="$options\n󰆽  Touchscreen"
  fi

  case $(menu "Hardware" "$options") in
  *Laptop*) skein_run skein-hyprland-monitor-internal toggle ;;
  *Mirror*) skein_run skein-hyprland-monitor-internal-mirror toggle ;;
  *Touchscreen*) skein_run skein-toggle-touchscreen ;;
  *) back_to show_trigger_menu ;;
  esac
}

# Theme, wallpaper and terminal font are in Settings > Appearance
show_style_menu() {
  case $(menu "Style" "  Hyprland\n󱄄  Screensaver\n  About") in
  *Hyprland*) open_in_editor ~/.config/hypr/looknfeel.lua ;;
  *Screensaver*) show_screensaver_menu ;;
  *About*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_about_menu() {
  case $(menu "About" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) skein_run skein-branding-about text ;;
  *Image*) skein_run skein-branding-about image ;;
  *Default*) skein_run skein-branding-about reset ;;
  *) show_style_menu ;;
  esac
}

show_screensaver_menu() {
  case $(menu "Screensaver" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) skein_run skein-branding-screensaver text ;;
  *Image*) skein_run skein-branding-screensaver image ;;
  *Default*) skein_run skein-branding-screensaver reset ;;
  *) show_style_menu ;;
  esac
}

show_theme_menu() {
  qs -c skein ipc call themes open
}

# Audio, Wi-Fi, Bluetooth, power, monitors, input and defaults are in Settings
show_setup_menu() {
  local options="󰱔  DNS\n  Security\n  Config"
  [ -f ~/.config/hypr/bindings.lua ] && options="$options\n  Keybindings"

  case $(menu "Setup" "$options") in
  *Keybindings*) open_in_editor ~/.config/hypr/bindings.lua ;;
  *DNS*) present_skein_terminal skein-setup-dns ;;
  *Security*) show_setup_security_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

# Reached from the battery icon; the rest of power is in Settings > Power & Idle
show_setup_power_menu() {
  profile=$(menu "Power Profile" "$(skein_run skein-powerprofiles-list)" "" "$(powerprofilesctl get)")

  if [[ "$profile" == "CNCLD" || -z "$profile" ]]; then
    show_setup_menu
  else
    skein_run skein-powerprofiles-set "$profile"
  fi
}

show_setup_security_menu() {
  case $(menu "Setup" "󰈷  Fingerprint\n  Fido2") in
  *Fingerprint*) present_skein_terminal skein-setup-security-fingerprint ;;
  *Fido2*) present_skein_terminal skein-setup-security-fido2 ;;
  *) show_setup_menu ;;
  esac
}

show_setup_config_menu() {
  case $(menu "Setup" "  Hyprland\n  Hypridle\n  Hyprsunset\n󰍜  Bar\n󰞅  XCompose") in
  *Hyprland*) open_in_editor ~/.config/hypr/hyprland.lua ;;
  *Hypridle*) open_in_editor ~/.config/hypr/hypridle.conf && skein_run skein-restart-hypridle ;;
  *Hyprsunset*) open_in_editor ~/.config/hypr/hyprsunset.conf && skein_run skein-restart-hyprsunset ;;
  *Bar*) open_in_editor ~/.config/quickshell/skein/Bar.qml ;;
  *XCompose*) open_in_editor ~/.XCompose && skein_run skein-restart-xcompose ;;
  *) show_setup_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "  Package\n  Flatpak\n  Web App\n  TUI\n  Style") in
  *Package*) terminal "$SKEIN_LIBEXEC_DIR/skein-pkg-install" ;;
  *Flatpak*) terminal "$SKEIN_LIBEXEC_DIR/skein-flatpak-install" ;;
  *Web*) present_skein_terminal skein-webapp-install ;;
  *TUI*) present_skein_terminal skein-tui-install ;;
  *Style*) show_install_style_menu ;;
  *) show_main_menu ;;
  esac
}

show_install_style_menu() {
  case $(menu "Install" "󰸌  Theme\n  Background") in
  *Theme*) present_terminal "$(skein_command skein-theme-install) \"\$(gum input --placeholder=\"https://github.com/...\" --header=\"Install user theme from repo URL:\")\"" ;;
  *Background*)
    theme="$(skein_run skein-theme-current || true)"
    if [ -z "$theme" ]; then
      notify-send "No active theme" "Set a theme before adding backgrounds"
    else
      dir="$HOME/.config/skein/backgrounds/$theme"
      mkdir -p "$dir" && nautilus "$dir"
    fi
    ;;
  *) show_install_menu ;;
  esac
}

show_remove_menu() {
  case $(menu "Remove" "  Package\n  Flatpak\n  Web App\n  TUI\n󰸌  Theme\n  Security") in
  *Package*) terminal "$SKEIN_LIBEXEC_DIR/skein-pkg-remove" ;;
  *Flatpak*) terminal "$SKEIN_LIBEXEC_DIR/skein-flatpak-remove" ;;
  *Web*) present_skein_terminal skein-webapp-remove ;;
  *TUI*) present_skein_terminal skein-tui-remove ;;
  *Theme*) present_terminal "$(skein_command skein-theme-remove) \"\$($(skein_command skein-theme-list-user) | gum choose --header=\"Remove user theme:\")\"" ;;
  *Security*) show_remove_security_menu ;;
  *) show_main_menu ;;
  esac
}

show_remove_security_menu() {
  case $(menu "Remove" "󰈷  Fingerprint\n  Fido2") in
  *Fingerprint*) present_skein_terminal skein-remove-security-fingerprint ;;
  *Fido2*) present_skein_terminal skein-remove-security-fido2 ;;
  *) show_remove_menu ;;
  esac
}

show_update_menu() {
  case $(menu "Update" "  Skein\n  Config\n󰸌  Theme\n  Process\n󰇅  Hardware\n  Password\n  Timezone") in
  *Skein*) present_skein_terminal skein-update ;;
  *Config*) show_update_config_menu ;;
  *Theme*) present_terminal "$(skein_command skein-theme-update) \"\$($(skein_command skein-theme-list-user) | gum choose --header=\"Update user theme:\")\"" ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Timezone*) present_skein_terminal skein-tz-select ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

show_update_process_menu() {
  case $(menu "Restart" "  Hypridle\n  Hyprsunset\n󰍜  Bar") in
  *Hypridle*) skein_run skein-restart-hypridle ;;
  *Hyprsunset*) skein_run skein-restart-hyprsunset ;;
  *Bar*) skein_run skein-restart-bar ;;
  *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  case $(menu "Use default config" "  Hyprland\n  Hypridle\n  Hyprsunset\n󱣴  Plymouth\n  Tmux\n󰍜  Bar") in
  *Hyprland*) present_skein_terminal skein-refresh-hyprland ;;
  *Hypridle*) present_skein_terminal skein-refresh-hypridle ;;
  *Hyprsunset*) present_skein_terminal skein-refresh-hyprsunset ;;
  *Plymouth*) present_skein_terminal skein-refresh-plymouth ;;
  *Tmux*) present_skein_terminal skein-refresh-tmux ;;
  *Bar*) present_skein_terminal skein-refresh-bar ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth") in
  *Audio*) present_skein_terminal skein-restart-pipewire ;;
  *Wi-Fi*) present_skein_terminal skein-restart-wifi ;;
  *Bluetooth*) present_skein_terminal skein-restart-bluetooth ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User") in
  *Drive*) present_skein_terminal skein-drive-password ;;
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  skein_run skein-launch-about
}

show_system_menu() {
  case $(menu "System" "  Lock\n󰍃  Logout\n󰜉  Reboot\n󰐥  Shutdown") in
  *Lock*) skein_run skein-system-lock ;;
  *Logout*) skein_run skein-system-logout ;;
  *Reboot*) skein_run skein-system-reboot ;;
  *Shutdown*) skein_run skein-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

# Your own entries: one per line in ~/.config/skein/menu-items, "Label<TAB>command" (lines starting with # are ignored)
CUSTOM_MENU_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/skein/menu-items"

show_custom_menu() {
  local label command entries=""
  while IFS=$'\t' read -r label command; do
    [[ -z $label || $label == \#* ]] && continue
    entries+="${entries:+\n}$label"
  done <"$CUSTOM_MENU_FILE"
  local choice
  choice="$(menu "Custom" "$entries")"
  [[ -z $choice ]] && { show_main_menu; return; }
  while IFS=$'\t' read -r label command; do
    [[ $label == "$choice" && -n $command ]] && { skein_run bash -c "$command"; return; }
  done <"$CUSTOM_MENU_FILE"
}

show_main_menu() {
  local search_file choice items
  search_file="$(mktemp)"
  "$SKEIN_LIBEXEC_DIR/skein-menu-index" >"$search_file" 2>/dev/null

  items="󰀻  Apps\t›\n󰒓  Settings\n󰧑  Learn\t›\n󱓞  Trigger\t›\n  Style\t›\n  Setup\t›\n󰉉  Install\t›\n󰭌  Remove\t›\n  Update\t›\n  About\n  System\t›"
  [[ -f $CUSTOM_MENU_FILE ]] && grep -qvE "^(#|[[:space:]]*$)" "$CUSTOM_MENU_FILE" && items+="\n󰣖  Custom\t›"
  choice="$(menu "Go" "$items" "" "" "$search_file")"
  rm -f "$search_file"

  if [[ $choice == @replay:* ]]; then
    # A search result: follow its path through the menus
    local -a steps
    IFS='|' read -r -a steps <<<"${choice#@replay:}"
    REPLAY_FILE="$(mktemp)"
    printf '%s\n' "${steps[@]:1}" >"$REPLAY_FILE"
    go_to_menu "${steps[0]}"
    rm -f "$REPLAY_FILE"
  else
    go_to_menu "$choice"
  fi
}

go_to_menu() {
  case "${1,,}" in
  *apps*) skein_run skein-launch-picker --show drun -p "Launch…" ;;
  *settings*) qs -c skein ipc call settings open ;;
  *custom*) show_custom_menu ;;
  *learn*) show_learn_menu ;;
  *trigger*) show_trigger_menu ;;
  *hardware*) show_hardware_menu ;;
  *share*) show_share_menu ;;
  *reminder-set*) show_custom_reminder_input ;;
  *reminder*) show_reminder_menu ;;
  *capture*) show_capture_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/skein/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
