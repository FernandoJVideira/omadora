#!/bin/bash
set -euo pipefail

# Show only "Plasma" and "Omadora" on the login screen.
# Runs as root (installer and dnf action after session packages update).

cat >/usr/share/wayland-sessions/omadora.desktop <<'DESKTOP'
[Desktop Entry]
Name=Omadora
Comment=Hyprland with Omadora, managed by UWSM
Exec=uwsm start -e -D Hyprland -N Hyprland -- /usr/bin/start-hyprland
DesktopNames=Hyprland
Type=Application
DESKTOP

for file in /usr/share/wayland-sessions/*.desktop /usr/share/xsessions/*.desktop; do
  [[ -f $file ]] || continue
  case $(basename "$file") in
  omadora.desktop | plasma.desktop) continue ;;
  esac
  grep -q '^NoDisplay=true' "$file" ||
    sed -i '/^\[Desktop Entry\]/a NoDisplay=true\nHidden=true' "$file"
done
