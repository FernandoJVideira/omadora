#!/usr/bin/env bash
set -euo pipefail

# Settings of the Skein dock, kept in ~/.config/skein/dock.json (the shell watches the file).
#   skein-dock init                        create the file with defaults, if missing
#   skein-dock set <key> <json value>      enabled, position, iconSize, magnify, magnifySize,
#                                          autoHide, showRunning, showIndicators, showTrash, showDownloads, iconPack (app icon folder, or empty for the system theme), iconPackName
#   skein-dock pin <desktop id>            add an app to the dock
#   skein-dock unpin <desktop id>          remove it
#   skein-dock move <desktop id> <-1|1>    move it one place left/up or right/down
#   skein-dock place <desktop id> <index>  put it at a position (0 is first), adding it if it is not there yet
#   skein-dock icon <app> <image path>     use your own icon for an app (<app> is its lowercase desktop id)
#   skein-dock icon-reset <app>            back to the pack or theme icon
#   skein-dock choose-icon <app>           pick the image with a file dialog, then do the same as "icon"
#   skein-dock apply <json object>         several of the settings above at once (a preset); never the apps or icons
#   skein-dock launcher <name> <command> [icon]  your own dock entry: a launcher running <command>; icon is an image
#                                          path or an icon name. It is also a desktop entry (~/.local/share/applications)
#   skein-dock launcher-remove <id>        delete one of those (id: skein-custom-<name>) and take it out of the dock
#   skein-dock toggle                      show or hide the dock

file="${XDG_CONFIG_HOME:-$HOME/.config}/skein/dock.json"

seed_pinned() {
  local dirs=(/usr/share/applications "$HOME/.local/share/applications" /var/lib/flatpak/exports/share/applications "$HOME/.local/share/flatpak/exports/share/applications")
  local id dir found
  local -a out=()
  for id in kitty brave-origin brave-browser org.mozilla.firefox org.gnome.Nautilus dev.zed.Zed discord spotify com.spotify.Client com.discordapp.Discord; do
    for dir in "${dirs[@]}"; do
      [[ -f $dir/$id.desktop ]] && { out+=("$id"); break; }
    done
  done
  printf '%s\n' "${out[@]}" | jq -R . | jq -sc .
}

init() {
  # An empty file counts as missing; the new one is written aside and moved in, never half-written
  [[ -s $file ]] && return 0
  mkdir -p "$(dirname "$file")"
  local tmp
  tmp="$(mktemp "$file.XXXXXX")"
  jq -n --argjson pinned "$(seed_pinned)" '{
    enabled: false, position: "bottom", iconSize: 48, magnify: true, magnifySize: 72,
    autoHide: false, showRunning: true, showIndicators: true, showTrash: true, showDownloads: true, pinned: $pinned}' >"$tmp" && mv "$tmp" "$file"
}

edit() { # <jq filter> [jq args...]
  local filter="$1"
  shift
  init
  local tmp
  tmp="$(mktemp "$file.XXXXXX")"
  jq "$@" "$filter" "$file" >"$tmp" && mv "$tmp" "$file" || rm -f "$tmp"
}

case "${1:-}" in
init) init ;;
set)
  [[ $2 =~ ^(enabled|position|iconSize|magnify|magnifySize|autoHide|showRunning|showIndicators|showTrash|showDownloads|iconPack|iconPackName)$ ]] || { echo "Unknown setting: $2" >&2; exit 1; }
  edit '.[$k] = $v' --arg k "$2" --argjson v "$3"
  ;;
apply)
  [[ -n ${2:-} ]] && jq -e 'type == "object"' <<<"$2" >/dev/null 2>&1 || { echo "Usage: skein-dock apply <json object>" >&2; exit 1; }
  edit '. + ($v | with_entries(select(.key | test("^(position|iconSize|magnify|magnifySize|autoHide|showRunning|showIndicators|showTrash|showDownloads)$"))))' --argjson v "$2"
  ;;
pin) edit '(.pinned // []) as $p | .pinned = (if ($p | index($id)) then $p else $p + [$id] end)' --arg id "$2" ;;
unpin) edit '.pinned -= [$id]' --arg id "$2" ;;
move)
  edit '(.pinned // []) as $p | ($p | index($id)) as $i
        | if $i == null or ($i + $d) < 0 or ($i + $d) >= ($p | length) then .
          else .pinned = ($p | .[$i] = $p[$i + $d] | .[$i + $d] = $p[$i]) end' --arg id "$2" --argjson d "$3"
  ;;
icon)
  [[ -f ${3:-} ]] || { echo "No such image: ${3:-}" >&2; exit 1; }
  edit '.icons = ((.icons // {}) + {($id): $path})' --arg id "$2" --arg path "$3"
  ;;
icon-reset) edit 'del(.icons[$id])' --arg id "$2" ;;
choose-icon)
  picked="$(zenity --file-selection --title="Icon for $2" --filename="$HOME/Pictures/" \
    --file-filter="Images | *.png *.svg *.jpg *.jpeg *.webp *.ico" 2>/dev/null)" || exit 0
  [[ -n $picked ]] && "$0" icon "$2" "$picked"
  ;;
place)
  edit '((.pinned // []) - [$id]) as $p | .pinned = ($p[0:$i] + [$id] + $p[$i:])' --arg id "$2" --argjson i "$3"
  ;;
launcher)
  [[ -n ${2:-} && -n ${3:-} ]] || { echo "Usage: skein-dock launcher <name> <command> [icon]" >&2; exit 1; }
  slug="$(tr '[:upper:]' '[:lower:]' <<<"$2" | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"
  [[ -n $slug ]] || slug=item
  id="skein-custom-$slug"
  dir="$HOME/.local/share/applications"
  mkdir -p "$dir"
  icon="${4:-}"
  icon="${icon/#\~/$HOME}"
  desktop_icon=application-x-executable
  [[ -n $icon && ! -f $icon ]] && desktop_icon="$icon"
  [[ -f $icon ]] && desktop_icon="$icon"
  # Exec quoting per the Desktop Entry spec: the command in double quotes, \ " $ ` escaped, % doubled
  exec_cmd="$(sed -E 's/\\/\\\\\\\\/g; s/"/\\\\"/g; s/\$/\\\\$/g; s/`/\\\\`/g; s/%/%%/g' <<<"$3")"
  printf '[Desktop Entry]\nType=Application\nName=%s\nExec=bash -c "%s"\nIcon=%s\nTerminal=false\nCategories=Utility;\n' "$2" "$exec_cmd" "$desktop_icon" >"$dir/$id.desktop"
  [[ -f $icon ]] && "$0" icon "$id" "$icon"
  "$0" pin "$id"
  ;;
launcher-remove)
  [[ ${2:-} == skein-custom-* ]] || { echo "Only skein-custom-* launchers can be removed" >&2; exit 1; }
  rm -f "$HOME/.local/share/applications/$2.desktop"
  "$0" unpin "$2"
  "$0" icon-reset "$2"
  ;;
toggle)
  init
  edit '.enabled = (.enabled | not)'
  ;;
*)
  echo "Usage: skein-dock init | set <key> <json> | pin <id> | unpin <id> | move <id> <-1|1> | icon <app> <file> | icon-reset <app> | choose-icon <app> | toggle" >&2
  exit 1
  ;;
esac
