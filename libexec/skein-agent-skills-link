#!/bin/bash

# Make Skein's agent skills (skein, diagnose-crash) available to the coding agents you use,
# by linking them into each agent's skills folder. Safe to run again.

set -euo pipefail

root="${SKEIN_PATH:-$HOME/.local/share/skein}"

targets=(
  "$HOME/.agents/skills"
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.pi/agent/skills"
  "$HOME/.gemini/config/skills"
)

for target in "${targets[@]}"; do
  mkdir -p "$target"
done

for skill in "$root"/default/agents/skills/*/; do
  # a folder without a SKILL.md is not a skill (an empty directory left behind by a rename, say)
  [[ -f ${skill}SKILL.md ]] || continue
  name="$(basename "$skill")"
  for target in "${targets[@]}"; do
    ln -sfn "${skill%/}" "$target/$name"
  done
done
