#!/usr/bin/env bash
set -uo pipefail

# Make the main display the X primary monitor, so Xwayland apps (Wine/Proton launchers)
# centre on it. Xwayland lists outputs in Hyprland's ID order, not by position.
# Main is the display at 0x0, as in skein-monitor-state; falls back to the leftmost, topmost one.

command -v xrandr >/dev/null 2>&1 || exit 0

name="$(hyprctl monitors -j 2>/dev/null | jq -r '
  (map(select(.x == 0 and .y == 0))[0] // (sort_by([.x, .y])[0])).name // empty')"
[[ -n $name ]] || exit 0

export DISPLAY="${DISPLAY:-:0}"
timeout 5 xrandr --output "$name" --primary >/dev/null 2>&1 || true
exit 0
