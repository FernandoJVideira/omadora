#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_SOURCE@ | grep -q MUTED; then
  led=on
  osd_message='Microphone muted'
  osd_icon=$'\U000f036d'
else
  led=off
  osd_message='Microphone on'
  osd_icon=$'\U000f036c'
fi

skein_run skein-brightness-keyboard-mute "$led"

skein_run skein-osd "$osd_icon" "$osd_message"
