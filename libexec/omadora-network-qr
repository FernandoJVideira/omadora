#!/bin/bash

# Write a Wi-Fi sharing QR code for a connection to a PNG and print its path.

if (($# != 1)); then
  echo "Usage: omadora-network-qr <connection>" >&2
  exit 1
fi

connection="$1"
ssid="$(nmcli -g 802-11-wireless.ssid connection show "$connection")"
password="$(nmcli --show-secrets -g 802-11-wireless-security.psk connection show "$connection")"

[[ -n $ssid && -n $password ]] || exit 1

escape() { sed 's/[\;,:"]/\\&/g' <<<"$1"; }

out="${XDG_RUNTIME_DIR:-/tmp}/omadora-wifi-qr.png"
qrencode -t PNG -s 6 -m 2 -o "$out" "WIFI:T:WPA;S:$(escape "$ssid");P:$(escape "$password");;" || exit 1
echo "$out"
