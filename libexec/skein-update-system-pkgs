#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

require_cmd pacman

info "Updating system packages"

if has_cmd yay; then
  yay -Syu --noconfirm ||
    die "failed to upgrade system packages"
else
  sudo pacman -Syu --noconfirm ||
    die "failed to upgrade system packages"
fi

# A new kernel on disk that differs from the running one means a reboot is needed.
if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  sudo touch /run/reboot-required
fi

# After a driver update the loaded NVIDIA module can differ from the new userspace libraries.
check_nvidia_mismatch() {
  local version_file=${SKEIN_NVIDIA_VERSION_FILE:-/proc/driver/nvidia/version}
  local loaded="" installed="" dir
  [[ -r $version_file ]] || return 0
  loaded=$(grep -m1 'Module' "$version_file" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1) || true
  for dir in ${SKEIN_NVIDIA_LIB_DIRS:-/usr/lib /usr/lib64}; do
    installed=$(compgen -G "$dir/libnvidia-ml.so.*.*.*" | head -n1) || true
    [[ -n $installed ]] && break
  done
  installed=${installed#*libnvidia-ml.so.}
  [[ -n $loaded && -n $installed && $loaded != "$installed" ]] || return 0
  warn "NVIDIA driver updated (loaded $loaded, installed $installed): reboot before logging out or the login screen will fail"
  sudo touch /run/reboot-required || true
}

check_nvidia_mismatch || true
