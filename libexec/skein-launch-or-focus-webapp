#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Launch or focus on a given web app identified by the window-pattern.

if (($# == 0)); then
  echo "Usage: skein-launch-or-focus-webapp <window-pattern> [url] [browser-flags...]" >&2
  exit 1
fi

WINDOW_PATTERN="$1"
shift

if (($# == 0)); then
  skein_exec skein-launch-or-focus "$WINDOW_PATTERN"
fi

skein_exec skein-launch-or-focus "$WINDOW_PATTERN" -- "$SKEIN_LIBEXEC_DIR/skein-launch-webapp" "$@"
