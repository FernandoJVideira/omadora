#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# shellcheck source=lib/service.sh
source "$OMADORA_LIB_DIR/service.sh"

# Toggle the top bar (Quickshell or Waybar)

readonly flag="waybar-off"
unit="$(service_bar_unit)"

# The Quickshell shell also runs notifications and the lock screen, so only hide its bar
if [[ $unit == omadora-bar.service ]]; then
  qs -c omadora ipc call bar toggle >/dev/null
  exit 0
fi

omadora_run omadora-toggle "$flag"

if omadora_run omadora-toggle-enabled "$flag"; then
  systemctl --quiet --user stop "$unit"
  notify-send -u low "󰍜    Top bar disabled"
else
  systemctl --quiet --user start "$unit"
  notify-send -u low "󰍜    Top bar enabled"
fi
