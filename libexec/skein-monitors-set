#!/usr/bin/env bash
set -euo pipefail

# Choose the main display and each display's resolution and refresh rate.
#   skein-monitors-set main <name>             make <name> the main display (0x0, workspaces 1-5)
#   skein-monitors-set layout <name>=<x>x<y>...  place every display at pixel positions, e.g. DP-1=0x0 HDMI-A-1=1920x0
#   skein-monitors-set apply <name> <mode>     try a mode now, without saving it (<mode> is WxH@Hz)
#   skein-monitors-set save <name> <mode>      keep a mode across restarts
#   skein-monitors-set save <name> auto        back to the monitor's best mode
# SKEIN_NO_APPLY=1 skips the live apply of layout. The layout lives in the generated blocks of ~/.config/hypr/monitors.lua.

lua="$(readlink -f "${SKEIN_MONITORS_LUA:-$HOME/.config/hypr/monitors.lua}")"
reload() { [[ -n ${SKEIN_NO_RELOAD:-} ]] || hyprctl reload >/dev/null; }

die() {
  echo -e "skein-monitors-set: $*" >&2
  exit 1
}

[[ -f $lua ]] || die "$lua not found"

# Replace the lines between "-- BEGIN generated: <name>" and "-- END generated: <name>" with a file
replace_block() { # <name> <body-file>
  awk -v name="$1" -v body="$2" '
    $0 ~ "^-- BEGIN generated: " name { print; while ((getline l < body) > 0) print l; skip = 1; next }
    $0 ~ "^-- END generated: " name { skip = 0 }
    !skip { print }' "$lua" >"$lua.new" && cat "$lua.new" >"$lua" && rm -f "$lua.new"
}

# Older layouts have no modes block and always pin the best mode: add the block and the check
ensure_modes_block() {
  grep -q '^-- BEGIN generated: modes' "$lua" && return 0
  grep -q '^-- END generated: monitors' "$lua" && grep -q 'local best = nil' "$lua" ||
    die "$lua is not a Skein monitor layout (missing generated blocks)"
  awk '
    { print }
    /^-- END generated: monitors/ {
      print ""
      print "-- Modes chosen in Settings > Display; monitors not listed run their best mode."
      print "-- BEGIN generated: modes (skein-monitors-set)"
      print "local configured_modes = {}"
      print "-- END generated: modes"
    }
    /^  local best = nil/ {
      print ""
      print "  local forced = configured_modes[mon.name]"
      print "  if forced then"
      print "    hl.monitor({ output = mon.name, mode = forced, position = position, scale = omarchy_monitor_scale })"
      print "    return"
      print "  end"
    }' "$lua" >"$lua.new" && cat "$lua.new" >"$lua" && rm -f "$lua.new"
}

monitor_json() { # <name>
  hyprctl monitors all -j | jq -ce --arg n "$1" '.[] | select(.name == $n)' || die "no monitor named $1"
}

check_mode() { # <name> <mode>
  [[ $2 =~ ^[0-9]+x[0-9]+@[0-9.]+$ ]] || die "mode must look like 1920x1080@144.00"
  monitor_json "$1" | jq -e --arg m "$2Hz" '.availableModes | index($m)' >/dev/null || die "$1 does not support $2"
}

case "${1:-}" in
main)
  name="${2:-}"
  [[ -n $name ]] || die "usage: skein-monitors-set main <name>"
  mapfile -t order < <(hyprctl monitors all -j | jq -r --arg n "$name" '
    [.[] | select(.disabled | not)] | sort_by(.x) | (map(select(.name == $n)) + map(select(.name != $n))) | .[].name')
  [[ ${order[0]:-} == "$name" ]] || die "no active monitor named $name"

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  echo '-- saved in Settings > Display' >"$tmp/pos"
  echo 'local configured_positions = {' >>"$tmp/pos"
  : >"$tmp/ws"
  i=0 x=0
  for mon in "${order[@]}"; do
    echo "  [\"$mon\"] = \"${x}x0\"," >>"$tmp/pos"
    x=$((x + $(hyprctl monitors all -j | jq --arg n "$mon" '.[] | select(.name == $n) | (.width / .scale | round)')))
    for ws in 1 2 3 4 5; do
      printf 'hl.workspace_rule({ workspace = "%d", monitor = "%s", default = %s, persistent = true })\n' \
        $((i * 5 + ws)) "$mon" "$([[ $ws == 1 ]] && echo true || echo false)" >>"$tmp/ws"
    done
    i=$((i + 1))
  done
  echo '}' >>"$tmp/pos"
  replace_block monitors "$tmp/pos"
  replace_block workspaces "$tmp/ws"
  reload
  "$(dirname "${BASH_SOURCE[0]}")/skein-xwayland-primary" || true
  ;;

layout)
  shift
  (($# > 0)) || die "usage: skein-monitors-set layout <name>=<x>x<y> ..."
  specs=()
  for arg in "$@"; do
    [[ $arg =~ ^(.+)=(-?[0-9]+)x(-?[0-9]+)$ ]] || die "bad position '$arg' (want NAME=XxY)"
    specs+=("$(jq -cn --arg n "${BASH_REMATCH[1]}" --argjson x "${BASH_REMATCH[2]}" --argjson y "${BASH_REMATCH[3]}" '{name: $n, x: $x, y: $y}')")
  done
  placed="$(printf '%s\n' "${specs[@]}" | jq -cs .)"
  active="$(hyprctl monitors all -j | jq -c '[.[] | select(.disabled | not)]')"
  errors="$(jq -rn --argjson act "$active" --argjson lay "$placed" '
    def touch($a; $b):
      (($a.x + $a.w == $b.x or $b.x + $b.w == $a.x) and $a.y < $b.y + $b.h and $b.y < $a.y + $a.h)
      or (($a.y + $a.h == $b.y or $b.y + $b.h == $a.y) and $a.x < $b.x + $b.w and $b.x < $a.x + $a.w);
    def overlap($a; $b):
      $a.x < $b.x + $b.w and $b.x < $a.x + $a.w and $a.y < $b.y + $b.h and $b.y < $a.y + $a.h;
    ($act | map(.name)) as $names
    | ($lay | map(.name)) as $given
    | ($names - $given | map("monitor not listed: " + .)[]),
      ($given - $names | map("not an active monitor: " + .)[]),
      ($given | group_by(.) | map(select(length > 1) | "listed twice: " + .[0])[]),
      (if ($names - $given | length) == 0 and ($given - $names | length) == 0 then
         [$lay[] | . as $p | ($act[] | select(.name == $p.name)) as $m
          | $p + {w: ($m.width / $m.scale | round), h: ($m.height / $m.scale | round)}] as $r
         | ([range(0; $r | length)] | map(. as $i | range($i + 1; $r | length) as $j
              | select(overlap($r[$i]; $r[$j])) | "overlap: \($r[$i].name) and \($r[$j].name)")[]),
           (if ($r | length) > 1 then
              $r[] | . as $a | select([$r[] | select(.name != $a.name) | select(touch($a; .))] | length == 0)
              | "not touching any other monitor: " + .name
            else empty end)
       else empty end)')"
  [[ -z $errors ]] || die "invalid layout:\n$errors"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  {
    echo '-- saved in Settings > Display'
    echo 'local configured_positions = {'
    jq -r 'sort_by([.x, .y])[] | "  [\"\(.name)\"] = \"\(.x)x\(.y)\","' <<<"$placed"
    echo '}'
  } >"$tmp/pos"
  replace_block monitors "$tmp/pos"
  if [[ -z ${SKEIN_NO_APPLY:-} ]]; then
    while IFS=$'\t' read -r name mode position scale; do
      hyprctl eval "hl.monitor({ output = \"$name\", mode = \"$mode\", position = \"$position\", scale = $scale })" >/dev/null
    done < <(jq -rn --argjson act "$active" --argjson lay "$placed" '
      $lay[] | . as $p | ($act[] | select(.name == $p.name))
      | [.name, "\(.width)x\(.height)@\(.refreshRate * 100 | round / 100)", "\($p.x)x\($p.y)", .scale] | @tsv')
    "$(dirname "${BASH_SOURCE[0]}")/skein-xwayland-primary" || true
  fi
  ;;

apply)
  name="${2:-}" mode="${3:-}"
  check_mode "$name" "$mode"
  scale="$(monitor_json "$name" | jq -r '.scale')"
  position="$(sed -n "s/.*\[\"$name\"\][[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$lua" | head -n1)"
  [[ -n $position ]] || position="$(monitor_json "$name" | jq -r '"\(.x)x\(.y)"')"
  hyprctl eval "hl.monitor({ output = \"$name\", mode = \"$mode\", position = \"$position\", scale = $scale })" >/dev/null
  ;;

save)
  name="${2:-}" mode="${3:-}"
  [[ $mode == auto ]] || check_mode "$name" "$mode"
  ensure_modes_block
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  declare -A modes=()
  while IFS=$'\t' read -r key value; do
    modes["$key"]="$value"
  done < <(awk '/^-- BEGIN generated: modes/ { on = 1; next } /^-- END generated: modes/ { on = 0 } on' "$lua" |
    sed -n 's/^[[:space:]]*\["\([^"]*\)"\][[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1\t\2/p')
  if [[ $mode == auto ]]; then
    unset 'modes[$name]'
  else
    modes["$name"]="$mode"
  fi
  {
    echo 'local configured_modes = {'
    for key in "${!modes[@]}"; do
      echo "  [\"$key\"] = \"${modes[$key]}\","
    done | sort
    echo '}'
  } >"$tmp/modes"
  replace_block modes "$tmp/modes"
  ;;

*)
  die "usage: skein-monitors-set main <name> | layout <name>=<x>x<y>... | apply <name> <mode> | save <name> <mode|auto>"
  ;;
esac
