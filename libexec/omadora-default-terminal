#!/bin/bash

# Set the default terminal used by xdg-terminal-exec (ported from Omarchy).
#   omadora-default-terminal                print the current default
#   omadora-default-terminal <terminal>     alacritty, foot, ghostty or kitty

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

here="$(dirname "${BASH_SOURCE[0]}")"
list="$HOME/.config/xdg-terminals.list"

if (($# == 0)); then
  desktop_id=$(xdg-terminal-exec --print-id 2>/dev/null || true)
  desktop_id=${desktop_id%%:*}
  case "$desktop_id" in
  Alacritty.desktop) echo "alacritty" ;;
  foot.desktop) echo "foot" ;;
  com.mitchellh.ghostty.desktop) echo "ghostty" ;;
  kitty.desktop) echo "kitty" ;;
  *) echo "$desktop_id" ;;
  esac
  exit 0
fi

case "$1" in
alacritty) terminal="alacritty"; desktop_id="Alacritty.desktop"; name="Alacritty"; glyph= ;;
foot) terminal="foot"; desktop_id="foot.desktop"; name="Foot"; glyph= ;;
ghostty) terminal="ghostty"; desktop_id="com.mitchellh.ghostty.desktop"; name="Ghostty"; glyph= ;;
kitty) terminal="kitty"; desktop_id="kitty.desktop"; name="Kitty"; glyph= ;;
*)
  echo "Usage: omadora-default-terminal <alacritty|foot|ghostty|kitty>" >&2
  exit 1
  ;;
esac

if "$here/omadora-cmd-missing" "$terminal"; then
  if [[ $installing == "false" ]]; then
    exec "$here/omadora-launch-floating-terminal-with-presentation" "$here/omadora-default-terminal" --install "$terminal"
  fi
  sudo dnf install -y "$terminal" || exit 1
fi

# The chosen terminal first; the rest of the list stays as fallbacks
others=""
if [[ -f $list ]]; then
  others="$(grep -vE '^[[:space:]]*(#|$)' "$list" | grep -vxF "$desktop_id" || true)"
fi

cat >"$list" <<LIST
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
$desktop_id
${others}
LIST
sed -i '/^$/d' "$list"

"$here/omadora-notification-send" "$glyph" "$name is now the default terminal"
