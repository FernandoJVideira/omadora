#!/usr/bin/env bash
set -euo pipefail

# Liquid Glass settings, kept in ~/.config/skein/glass.conf (key=value lines; the shell and Hyprland read it).
#   skein-glass get                  print the settings
#   skein-glass set enabled 0|1      glass on or off
#   skein-glass set blur <0.5-6>     blur strength (2 is the default)
# Applied at once when the HyprGlass plugin is loaded; without it only the shell's own surfaces change.

file="${XDG_CONFIG_HOME:-$HOME/.config}/skein/glass.conf"
mkdir -p "$(dirname "$file")"
[[ -f $file ]] || printf 'enabled=1\nblur=2.0\n' >"$file"

value() { sed -n "s/^$1=//p" "$file" | head -1; }

apply() {
  local enabled blur
  enabled="$(value enabled)"
  blur="$(value blur)"
  if hyprctl plugin list 2>/dev/null | grep -q hyprglass; then
    hyprctl eval "hl.plugin.hyprglass.config({ enabled = $([[ $enabled == 0 ]] && echo false || echo true), blur_strength = ${blur:-2.0} })" >/dev/null
  else
    hyprctl reload >/dev/null 2>&1 || true
  fi
}

case "${1:-}" in
get) cat "$file" ;;
set)
  key="${2:-}"
  val="${3:-}"
  case "$key" in
  enabled) [[ $val =~ ^[01]$ ]] || { echo "enabled takes 0 or 1" >&2; exit 1; } ;;
  blur) [[ $val =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk "BEGIN{exit !($val >= 0.5 && $val <= 6)}" || { echo "blur takes a number from 0.5 to 6" >&2; exit 1; } ;;
  *) echo "Unknown setting: $key" >&2; exit 1 ;;
  esac
  grep -q "^$key=" "$file" && sed -i "s/^$key=.*/$key=$val/" "$file" || echo "$key=$val" >>"$file"
  apply
  ;;
*)
  echo "Usage: skein-glass get | set enabled 0|1 | set blur <0.5-6>" >&2
  exit 1
  ;;
esac
