#!/bin/bash

# Launch the default coding agent with a prompt.
#   skein-agent-prompt [--inline] <prompt...>

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: skein-agent-prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec "$(dirname "${BASH_SOURCE[0]}")/skein-agent" "${inline[@]}" --prompt "$*"
