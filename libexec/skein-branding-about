#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Edit, set, or reset About branding

set -euo pipefail

case "${1:-}" in
image)
  image=$(skein_run skein-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && skein_run skein-transcode-ascii "$image" ~/.config/skein/branding/about.txt --width 54 --height 26 --mode block; then
    skein_run skein-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  skein_run skein-launch-editor ~/.config/skein/branding/about.txt >/dev/null 2>&1 && skein_run skein-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$SKEIN_PATH/icon.txt" ~/.config/skein/branding/about.txt && skein_run skein-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: skein-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
