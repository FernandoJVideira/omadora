#!/usr/bin/env bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Toggle Update Checks

readonly flag="update-check-off"
readonly unit="skein-update-check.timer"

skein_run skein-toggle "$flag"

if skein_run skein-toggle-enabled "$flag"; then
  systemctl --quiet --user stop "$unit"
  notify-send -u low "󰏗    Update checks disabled"
else
  systemctl --quiet --user start "$unit"
  notify-send -u low "󰏗    Update checks enabled"
fi

skein_run skein-bar-refresh update
