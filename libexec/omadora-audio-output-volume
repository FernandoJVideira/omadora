#!/bin/bash

# Adjust audio output volume.

cmd="${1:-raise}"

if [[ $cmd == "raise" ]]; then
  wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
  wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 0.05+
elif [[ $cmd == "lower" ]]; then
  wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-
elif [[ $cmd == "mute-toggle" ]]; then
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
fi

read -r _ level muted < <(wpctl get-volume @DEFAULT_AUDIO_SINK@)
percent=$(awk -v level="$level" 'BEGIN { printf "%d", level * 100 }')

if [[ $muted == "[MUTED]" ]]; then
  "$(dirname "${BASH_SOURCE[0]}")/omadora-osd" $'\U000f0581' "Output muted" "$percent"
else
  "$(dirname "${BASH_SOURCE[0]}")/omadora-osd" $'\U000f057e' "Output volume" "$percent"
fi
