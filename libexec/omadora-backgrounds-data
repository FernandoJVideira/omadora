#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# shellcheck source=lib/theme.sh
source "$OMADORA_LIB_DIR/theme.sh"

# List the backgrounds of the current theme as JSON for the Quickshell wallpaper switcher.
#   [{"key":"/…/0-winding-road.webp","label":"Winding Road","preview":"/…","background":"/…","current":true}]
# Same sources and order as omadora-theme-bg-next: your own backgrounds for the theme, then the theme's.

require_cmd jq

theme="$(theme_current)" || die "no current theme set"
current="$(readlink "$OMADORA_CURRENT_BACKGROUND_LINK" 2>/dev/null || true)"

find -L "$OMADORA_USER_BACKGROUNDS_DIR/$theme" "$OMADORA_CURRENT_THEME_DIR/backgrounds" \
  -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
  -print0 2>/dev/null | sort -z |
  jq -Rsc --arg current "$current" '
    split("\u0000") | map(select(. != "")) | map({
      key: .,
      label: (split("/")[-1] | sub("\\.[^.]+$"; "") | sub("^[0-9]+-"; "") | split("-") | map(.[0:1] + .[1:] | (.[0:1] | ascii_upcase) + .[1:]) | join(" ")),
      preview: .,
      background: .,
      current: (. == $current)
    })'
