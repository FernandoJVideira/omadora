#!/usr/bin/env bash

# Move an existing install from Omadora's names to Skein's (run once; safe to repeat):
#   ~/.config|.local/state|.cache/omadora  and  ~/.config/quickshell/omadora  ->  .../skein
# Each old path stays behind as a symlink to the new one, so configs that still mention the old name
# keep working. Config files the installer copied into ~/.config (hypr/bindings.lua, ...) are rewritten
# in place, since they name commands, keys and paths (a copy is kept in ~/.config/skein-backup). The old user units (omadora-*.service, timers, targets) are disabled and removed;
# the installer then enables the skein-* ones. A running session keeps its old units until you log
# out, so log out or reboot afterwards. (~/.local/share/omadora, the checkout itself, is moved by
# whoever runs the new checkout: the dotfiles installers do.) The agent skill that was called omadora
# is now skein: its old links (~/.claude/skills/omadora, ...) are removed and the skills linked again.
set -euo pipefail

rename_dir() {
  local old="$1" new="$2"
  [[ -e $old && ! -L $old ]] || return 0
  if [[ -e $new ]]; then
    echo "skein-migrate-names: $new already exists, leaving $old alone" >&2
    return 0
  fi
  mkdir -p "$(dirname "$new")"
  mv "$old" "$new"
  ln -s "$new" "$old"
  echo "Moved $old -> $new"
}

rename_dir "$HOME/.config/omadora" "$HOME/.config/skein"
rename_dir "$HOME/.local/state/omadora" "$HOME/.local/state/skein"
rename_dir "$HOME/.cache/omadora" "$HOME/.cache/skein"
rename_dir "$HOME/.config/quickshell/omadora" "$HOME/.config/quickshell/skein"

# Files the installer copied from the checkout's config/ into ~/.config (not links, so they are the
# user's own copies) name the old commands, binding keys and paths: rewrite them in place.
checkout="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
backup="$HOME/.config/skein-backup/names-$(date +%Y%m%d%H%M%S)"
rewrite_names() {
  local file="$1" rel="$2"
  [[ -f $file && ! -L $file ]] || return 0
  grep -qE 'omadora|OMADORA|Omadora|omactl|OMACTL' "$file" 2>/dev/null || return 0
  mkdir -p "$backup/$(dirname "$rel")"
  cp -a "$file" "$backup/$rel"
  sed -i.tmp -e 's/OMADORA/SKEIN/g' -e 's/Omadora/Skein/g' -e 's/OMACTL/SKEINCTL/g' \
    -e 's/omactl/skeinctl/g' -e 's/omadora/skein/g' "$file" && rm -f "$file.tmp"
  echo "Rewrote the old names in $file"
}
while IFS= read -r -d '' src; do
  rel="${src#"$checkout"/config/}"
  rewrite_names "$HOME/.config/$rel" "$rel"
done < <(find "$checkout/config" -type f -print0)
rewrite_names "$HOME/.bashrc" bashrc

# The agent skill was called omadora (default/agents/skills/omadora, linked into each agent's skills
# folder): its links now dangle, so remove them and link the skills again under their new names.
relink_skills=0
for skills in "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.pi/agent/skills" "$HOME/.gemini/config/skills"; do
  if [[ -L $skills/omadora ]]; then
    rm -f "$skills/omadora"
    relink_skills=1
    echo "Removed the old skill link $skills/omadora"
  fi
done
if ((relink_skills)); then
  SKEIN_PATH="$checkout" "$checkout/libexec/skein-agent-skills-link"
  echo "Linked the skein skills"
fi

units="$HOME/.config/systemd/user"
declare -A was_enabled=()
if [[ -d $units ]]; then
  for unit in "$units"/omadora-*; do
    [[ -e $unit || -L $unit ]] || continue
    name="$(basename "$unit")"
    systemctl --user is-enabled --quiet "$name" 2>/dev/null && was_enabled["${name#omadora-}"]=1
    # no --now: the running session keeps its units until the next login
    systemctl --user disable "$name" 2>/dev/null || true
    rm -f "$unit"
    echo "Removed the old unit $name"
  done
  # enablement links that pointed at the removed units
  find "$units" -type l -name 'omadora-*' ! -exec test -e {} \; -delete
fi

# The installer isn't run again for an existing checkout, so put the renamed units and the Quickshell
# config in place the way it does (cp -R config/. ~/.config/), and enable what was enabled before.
if ((${#was_enabled[@]})); then
  mkdir -p "$units" "$HOME/.config/quickshell"
  cp -R "$checkout/config/systemd/user/." "$units/"
  cp -R "$checkout/config/quickshell/skein" "$HOME/.config/quickshell/"
  systemctl --user daemon-reload 2>/dev/null || true
  for suffix in "${!was_enabled[@]}"; do
    systemctl --user enable "skein-$suffix" 2>/dev/null && echo "Enabled skein-$suffix" \
      || echo "skein-migrate-names: couldn't enable skein-$suffix" >&2
  done
fi
systemctl --user daemon-reload 2>/dev/null || true
