#!/bin/bash

# Launch the default coding agent in a terminal (ported from Omarchy).
#   omadora-agent [--inline] [--pick] [--prompt <text>]
# --inline runs it in the current terminal; --pick offers the choice when no default is set.

here="$(dirname "${BASH_SOURCE[0]}")"
inline=false
pick=false

while (($#)); do
  case "$1" in
  --inline)
    inline=true
    shift
    ;;
  --pick)
    pick=true
    shift
    ;;
  --prompt)
    prompt=${2:?--prompt needs a value}
    shift 2
    ;;
  *)
    echo "Unexpected argument: $1" >&2
    echo "To pass a prompt: omadora-agent-prompt \"$*\"" >&2
    exit 1
    ;;
  esac
done

# Agents refuse to remember trust for $HOME, so launches from a keybinding or the
# menu start in the work directory instead of re-asking on every session.
[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

agent=$("$here/omadora-default-agent")

# There is nothing to launch until a default is picked
if [[ -z $agent ]]; then
  [[ $pick == "true" ]] && exec "$here/omadora-menu" agent
  echo "Choose a default agent with: omadora-default-agent <name>" >&2
  exit 1
fi

if "$here/omadora-cmd-missing" "$agent"; then
  echo "$agent is not installed. Choose an installed agent with: omadora-default-agent <name>" >&2
  exit 1
fi

# Agents launched this way run unattended, so each starts with its own spelling of "don't stop to ask"
case "$agent" in
opencode)
  command=(opencode --auto)
  [[ -n ${prompt:-} ]] && command+=(--prompt "$prompt")
  ;;
agy)
  command=(agy --dangerously-skip-permissions)
  [[ -n ${prompt:-} ]] && command+=(--prompt-interactive "$prompt")
  ;;
copilot)
  command=(copilot --allow-all)
  [[ -n ${prompt:-} ]] && command+=(--interactive "$prompt")
  ;;
crush)
  if [[ -n ${prompt:-} ]]; then
    command=(crush run "$prompt")
  else
    command=(crush --yolo)
  fi
  ;;
claude)
  command=(claude --permission-mode auto)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
grok)
  command=(grok --permission-mode bypassPermissions)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
codex)
  command=(codex --approve-for-me)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
cursor-agent)
  command=(cursor-agent --yolo --trust)
  [[ -n ${prompt:-} ]] && command+=(agent -- "$prompt")
  ;;
muse)
  command=(muse --approval-mode never)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
omp)
  command=(omp --auto-approve)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
ori)
  command=(ori code)
  [[ -n ${prompt:-} ]] && command+=(--interactive --prompt "$prompt")
  ;;
pi)
  command=(pi)
  [[ -n ${prompt:-} ]] && command+=("$prompt")
  ;;
*)
  echo "Unsupported default agent: $agent" >&2
  exit 1
  ;;
esac

if [[ $inline == "true" ]]; then
  exec "${command[@]}"
else
  # A fixed app-id rather than org.omadora.<binary>, so every agent window shares one class
  exec uwsm-app -S both -- xdg-terminal-exec --app-id=org.omadora.agent -e "${command[@]}"
fi
