#!/bin/bash

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# Switch the top bar between Quickshell (default) and Waybar.

readonly flag="$HOME/.local/state/omadora/toggles/bar-waybar"

case "${1:-}" in
quickshell)
  rm -f "$flag"
  systemctl --quiet --user stop waybar.service || true
  systemctl --quiet --user start omadora-bar.service
  ;;
waybar)
  mkdir -p "$(dirname "$flag")"
  touch "$flag"
  systemctl --quiet --user stop omadora-bar.service || true
  systemctl --quiet --user start waybar.service
  ;;
*)
  echo "Usage: omadora-bar-use <quickshell|waybar>" >&2
  exit 1
  ;;
esac

notify-send -u low "󰍜    Top bar: $1"
