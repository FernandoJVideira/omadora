#!/usr/bin/env bash

set -u

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../lib/common/init.sh"

# Watch Hyprland monitor events and recover monitor toggles when a monitor is removed.

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

if ! command -v socat >/dev/null 2>&1; then
  echo "socat is not installed; monitor recovery is disabled until 'sudo dnf install socat' (or your distro's equivalent) is run" >&2
  exit 0
fi

socat -U - "UNIX-CONNECT:$SOCKET" | while IFS= read -r event; do
  case "$event" in
  monitorremovedv2\>\>*)
    skein_run skein-hyprland-monitor-internal recover
    skein_run skein-hyprland-monitor-internal-mirror recover
    "$(dirname "${BASH_SOURCE[0]}")/../skein-xwayland-primary" || true
    ;;
  esac
done

# The event stream is expected to live for the duration of the Hyprland
# session. Reaching EOF while systemd still considers this service active is
# an unexpected failure and should trigger Restart=on-failure.
exit 1
