#!/usr/bin/env bash
# Drop KDE Plasma from Nobara (Plasma Login Manager is already replaced by the greeter, see skein-greeter):
# skein-remove-kde [schedule|remove|clean|status|list] [--kde-only] [--yes] [--home DIR]
#
#   schedule  queue the removal and the home cleanup for the next boot, before the login screen starts.
#             The install scripts use this: from inside a Plasma session, removing Plasma Login Manager
#             would end the session and the installer with it. Needs the greeter (skein-greeter install).
#   remove    remove KDE Plasma, its apps and the default apps Nobara ships, once you are logged in through
#             greetd: it shows the dnf preview and waits for you to type REMOVE.
#   list      show, without changing anything, the packages a removal would take and the ones kept.
#   clean     list the Plasma/KDE config, caches and unused Flatpak runtimes left in your home, and delete
#             them once you type DELETE.
#   --kde-only keeps the other default apps; --yes skips the questions (what schedule runs at boot).
#
# Always keeps the Nobara packages (nobara-*), Hyprland and Quickshell, the gaming stack and KWallet
# (the secret service). dnf is told to protect them and the preview is checked for them too.

set -euo pipefail

log() { printf '\033[32m==>\033[0m %s\n' "$*"; }

PROTECTED_FILE=/etc/dnf/protected.d/skein-nobara.conf
LEGACY_PROTECTED_FILE=/etc/dnf/protected.d/omadora-nobara.conf  # written before the rename, never cleaned up
PENDING=/etc/skein/remove-kde.pending
UNIT=/etc/systemd/system/skein-remove-kde.service
INSTALLED_COPY=/usr/local/libexec/skein-remove-kde

YES=0
KDE_ONLY=0
TARGET_HOME="${HOME:-}"  # unset when systemd runs "boot"; cmd_boot reads the home from the pending file

as_root() { if ((EUID == 0)); then "$@"; else sudo "$@"; fi; }

die() { printf '\033[31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

not_in_plasma() {
  [[ ${XDG_CURRENT_DESKTOP:-} != *KDE* ]] \
    || die "you are in a Plasma session. Log into Skein (Hyprland) first and run this from there."
}

# Packages to remove, matched against what is installed. Globs allowed.
KDE_PACKAGES=(
  'plasma-*' 'kwin*' 'kscreen*' kscreenlocker kdeplasma-addons kinfocenter kmenuedit khelpcenter
  kde-gtk-config kde-settings-plasma kde-settings-pulseaudio bluedevil 'polkit-kde*' 'kde-connect*'
  'kdeconnect*' kdnssd krdp kio-admin audiocd-kio kde-inotify-survey kdebugsettings kjournald
  kdegraphics-thumbnailers ffmpegthumbs kdenetwork-filesharing 'akonadi*' 'kaccounts-*'
  signon-kwallet-extension kwebkitpart kf6-baloo-file flatpak-kcm colord-kde kde-partitionmanager
  'kwalletmanager*' ksshaskpass
  # KDE 4 era libraries and Nobara's Plasma tweaks, left over once Plasma itself is gone
  'kdelibs*' 'kde-runtime*' kde-platform-plugin kde-workspace-common kde-l10n kde-apps-rpm-macros
  kde4-filesystem kde-settings 'kde-nobara*' kde-steamdeck-additions
  dolphin 'dolphin-*' konsole kate kwrite okular gwenview ark spectacle kcalc kcharselect kfind
  filelight kdialog elisa-player kdenlive
)
# The default apps of the Nobara KDE image that this setup replaces or doesn't use
# (OnlyOffice for LibreOffice, mpv for VLC, Brave Origin for Brave). Gaming tools stay.
DEFAULT_APPS=(
  'libreoffice*' inkscape blender obs-studio prismlauncher mariadb-server mariadb-embedded
  calamares mediawriter 'vlc*' brave-browser firefox
)
# Never removed: dnf protects them, and a preview that would take one is refused.
KEEP_PACKAGES=(
  'nobara-*' greetd cage 'hyprland*' 'quickshell*' uwsm xfce-polkit NetworkManager 'pipewire*' wireplumber
  systemd 'kernel*' 'dnf*' flatpak kitty zsh git steam lutris 'heroic*' gamescope 'wine*'
  mangohud goverlay protonplus 'umu-launcher' timeshift falcond inputplumber '*kwallet*'
  # needed by the KWallet libraries, the Qt/KF libraries Quickshell uses, and Nobara's identity
  'kf5-*' kde-filesystem 'nobara-release*' plasma-breeze-common
  # what this desktop uses: the shell prompt, the Nerd Font and the icon theme
  starship jetbrainsmono-nerd-fonts 'papirus-icon-theme*'
)

installed() { rpm -qa --qf '%{NAME}\n' | sort -u; }

# names from the installed set matching any of the given globs
matching() {
  local name pat
  while IFS= read -r name; do
    for pat in "$@"; do
      # shellcheck disable=SC2053
      [[ $name == $pat ]] && { printf '%s\n' "$name"; break; }
    done
  done < <(installed)
}

# Names of kwalletmanager and signon-kwallet-extension are GUI/Plasma pieces, not the secret service
keep_names() {
  matching "${KEEP_PACKAGES[@]}" | grep -vxE 'kwalletmanager.*|signon-kwallet-extension' || true
}

# the packages a removal would take (empty when there is nothing left)
selected_packages() {
  local patterns=("${KDE_PACKAGES[@]}")
  ((KDE_ONLY)) || patterns+=("${DEFAULT_APPS[@]}")
  matching "${patterns[@]}" | grep -vxFf <(keep_names) || true
}

# the greeter has to be in place, or removing Plasma Login Manager would leave no login screen
greeter_ready() {
  local p
  for p in greetd cage quickshell; do rpm -q "$p" &>/dev/null || return 1; done
  systemctl is-enabled --quiet greetd.service 2>/dev/null || return 1
  grep -q skein-greeter /etc/greetd/config.toml 2>/dev/null
}

cmd_status() {
  printf 'display manager: %s\n' "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || echo none)"
  for p in greetd cage plasma-login-manager plasma-desktop; do
    printf '%-22s %s\n' "$p" "$(rpm -q "$p" 2>/dev/null | head -n 1)"
  done
  [[ -f $PENDING ]] && echo "removal scheduled for the next boot ($PENDING)"
  [[ -n ${XDG_SESSION_ID:-} ]] && printf 'this session came from: %s\n' "$(loginctl show-session "$XDG_SESSION_ID" -p Service --value 2>/dev/null)"
  return 0
}

# Fedora's KDE packages protect themselves from removal (plasma-desktop.conf in protected.d), which
# makes dnf refuse the whole transaction. Take the packages being removed out of those lists for the
# duration, and put the lists back if the removal doesn't happen.
PROTECTED_DIRS=(/etc/dnf/protected.d /usr/share/dnf5/protected.d)
LIFTED=()

lift_protection() {
  local dir f
  for dir in "${PROTECTED_DIRS[@]}"; do
    for f in "$dir"/*.conf; do
      [[ -f $f && $f != "$PROTECTED_FILE" ]] || continue
      grep -vE '^[[:space:]]*(#|$)' "$f" | sed 's/[[:space:]]*$//' | grep -qxFf <(printf '%s\n' "$@") || continue
      local keep
      keep=$(grep -vE '^[[:space:]]*(#|$)' "$f" | sed 's/[[:space:]]*$//' | grep -vxFf <(printf '%s\n' "$@") || true)
      log "Lifting dnf's protection of the packages in $f"
      as_root cp -p "$f" "$f.skein-lifted"
      if [[ -n $keep ]]; then printf '%s\n' "$keep" | as_root tee "$f" >/dev/null; else as_root rm -f "$f"; fi
      LIFTED+=("$f")
    done
  done
}

restore_protection() {
  local f
  for f in "${LIFTED[@]}"; do
    [[ -f $f.skein-lifted ]] && as_root mv -f "$f.skein-lifted" "$f"
  done
  LIFTED=()
}

# the packages are gone: drop the saved copies
settle_protection() {
  local f
  for f in "${LIFTED[@]}"; do as_root rm -f "$f.skein-lifted"; done
  LIFTED=()
}

# The protection only has to hold while this script's own dnf transactions run. Left in place, it
# makes dnf5 refuse every later kernel install or removal, since it protects by package name.
PROTECTED_WRITTEN=0
drop_protected_file() {
  ((PROTECTED_WRITTEN)) || return 0
  as_root rm -f "$PROTECTED_FILE" "$LEGACY_PROTECTED_FILE"
}

cleanup() {
  restore_protection
  drop_protected_file
}
trap cleanup EXIT

# Protect what must stay: dnf then refuses a transaction that would remove any of it.
write_protected() {
  PROTECTED_WRITTEN=1
  keep_names | as_root tee "$PROTECTED_FILE" >/dev/null
}

# Package names a dnf preview would remove (first column of the Removing sections)
preview_names() {
  awk 'NF >= 3 && $2 ~ /^(x86_64|noarch|i686|aarch64)$/ {print $1}' <<<"$1" | sort -u
}

check_preview() {
  local output="$1" hit
  if grep -qE 'Failed to resolve|^[[:space:]]*(1\. )?Problem' <<<"$output"; then
    printf '\033[31mdnf could not resolve the transaction (see above).\033[0m\n' >&2
    return 1
  fi
  hit=$(comm -12 <(preview_names "$output") <(keep_names | sort -u))
  if [[ -n $hit ]]; then
    printf '\033[31mThe preview would remove packages that must stay:\033[0m\n%s\n' "$hit" >&2
    return 1
  fi
}

# preview a dnf transaction, refuse it if it touches a protected package, ask, then run it
run_transaction() {
  local label="$1"; shift
  local preview
  preview=$(as_root dnf "$@" --assumeno 2>&1 || true)
  printf '%s\n' "$preview"
  check_preview "$preview" || die "$label aborted: nothing was removed."
  if ((!YES)); then
    printf '\nType REMOVE to run this %s: ' "$label"
    local answer; read -r answer
    [[ $answer == REMOVE ]] || { log "Skipped $label."; return 1; }
  fi
  as_root dnf "$@" -y
}

# Some of what the desktop uses was only installed as a dependency of KDE packages (the prompt, the
# Nerd Font). Mark it as installed on purpose, or removing KDE would take it along as "unused".
mark_keepers() {
  local keep
  mapfile -t keep < <(matching starship jetbrainsmono-nerd-fonts 'papirus-icon-theme*')
  ((${#keep[@]})) || return 0
  log "Keeping ${keep[*]} (marked as installed on purpose)"
  as_root dnf mark user -y "${keep[@]}" >/dev/null
}

cmd_list() {
  log "A removal would take:"
  selected_packages | sed 's/^/  /'
  log "and always keeps (the ones installed):"
  keep_names | sed 's/^/  /' | head -40
}

cmd_remove() {
  not_in_plasma
  if ((YES)); then
    greeter_ready || die "the greeter isn't set up (skein-greeter install), so removing Plasma Login Manager could leave no login screen."
  else
    local from=""
    [[ -n ${XDG_SESSION_ID:-} ]] && from=$(loginctl show-session "$XDG_SESSION_ID" -p Service --value 2>/dev/null || true)
    [[ $from == greetd ]] \
      || die "this session wasn't started by greetd (it came from '${from:-unknown}'). Run skein-greeter install, reboot and log in through it first."
    rpm -q greetd &>/dev/null || die "greetd isn't installed"
  fi

  local packages
  mapfile -t packages < <(selected_packages)
  ((${#packages[@]})) || { log "Nothing left to remove."; return 0; }

  log "${#packages[@]} packages selected:"
  printf '  %s\n' "${packages[@]}"
  mark_keepers
  write_protected
  lift_protection "${packages[@]}"

  run_transaction "removal" remove "${packages[@]}" || { restore_protection; return 0; }
  settle_protection

  if ((!YES)); then
    log "The Plasma libraries it leaves behind (Qt/KF6) are mostly still needed by Quickshell and other apps."
    printf 'Also remove packages nothing needs any more? Preview first [y/N]: '
    local answer; read -r answer
    [[ $answer =~ ^[Yy] ]] && { run_transaction "autoremove" autoremove || true; }
  fi
  log "Done. Plasma is gone; the login screen is the Quickshell greeter. Next: skein-remove-kde clean (KDE leftovers in your home)."
}

# KDE leftovers in $HOME. KWallet (kwalletrc, kwalletd/) is deliberately not listed: it is Skein's
# secret service. Globs are relative to $HOME and expanded here, never passed to rm unexpanded.
CLEAN_GLOBS=(
  '.config/plasma*' '.config/kde*' '.config/kwin*' '.config/kscreen*' '.config/kded*' '.config/ksmserver*'
  '.config/kactivitymanagerd*' '.config/kglobalshortcutsrc' '.config/kxkbrc' '.config/klipperrc'
  '.config/systemsettingsrc' '.config/powermanagementprofilesrc' '.config/breezerc' '.config/baloofilerc'
  '.config/dolphinrc' '.config/konsolerc' '.config/katerc' '.config/kate*' '.config/kwriterc'
  '.config/okularrc' '.config/okularpartrc' '.config/gwenviewrc' '.config/arkrc' '.config/spectaclerc'
  '.config/kcalcrc' '.config/kdeconnect' '.config/plasmarc' '.config/plasmashellrc'
  '.local/share/plasma*' '.local/share/kate' '.local/share/konsole' '.local/share/dolphin'
  '.local/share/baloo' '.local/share/kactivitymanagerd' '.local/share/klipper' '.local/share/kscreen'
  '.local/share/okular' '.local/share/gwenview' '.local/share/kded*' '.local/share/kwin'
  '.local/share/kxmlgui5' '.local/share/kservices*' '.local/share/knewstuff3' '.local/share/kpeople'
  '.cache/plasma*' '.cache/kde*' '.cache/ksycoca*' '.cache/kio*' '.cache/baloo*' '.cache/kscreen*'
)

cmd_clean() {
  not_in_plasma
  rpm -q plasma-desktop &>/dev/null && die "Plasma is still installed. Run skein-remove-kde remove first."
  local found=() glob path
  shopt -s nullglob
  for glob in "${CLEAN_GLOBS[@]}"; do
    for path in "$TARGET_HOME"/$glob; do
      [[ -e $path || -L $path ]] || continue
      case $path in
        "$TARGET_HOME"/.config/kwalletrc | "$TARGET_HOME"/.local/share/kwalletd*) continue ;;
      esac
      found+=("$path")
    done
  done
  shopt -u nullglob
  # two globs can match the same path
  ((${#found[@]})) && mapfile -t found < <(printf '%s\n' "${found[@]}" | sort -u)

  if ((${#found[@]})); then
    log "${#found[@]} KDE leftovers in $TARGET_HOME:"
    du -sh -- "${found[@]}" 2>/dev/null | sed 's/^/  /'
  else
    log "No KDE leftovers in $TARGET_HOME."
  fi

  local runtimes=""
  if command -v flatpak >/dev/null; then
    runtimes=$(flatpak uninstall --unused --assumeno 2>&1 | grep -E '^ *[0-9]+\.' || true)
    [[ -n $runtimes ]] && { log "Unused Flatpak runtimes:"; printf '%s\n' "$runtimes"; }
  fi

  ((${#found[@]})) || [[ -n $runtimes ]] || return 0
  if ((!YES)); then
    printf '\nType DELETE to remove the above (your KWallet data stays): '
    local answer; read -r answer
    [[ $answer == DELETE ]] || { log "Left everything in place."; return 0; }
  fi
  ((${#found[@]})) && rm -rf -- "${found[@]}"
  [[ -n $runtimes ]] && flatpak uninstall --unused -y
  log "Done."
}

cmd_schedule() {
  greeter_ready || die "install the greeter first: skein-greeter install (and reboot, so greetd is what logs you in)."
  if [[ -z $(selected_packages) ]]; then
    log "No KDE packages left; cleaning the leftovers in your home."
    YES=1 cmd_clean
    return
  fi

  as_root install -Dm755 "$(readlink -f "${BASH_SOURCE[0]}")" "$INSTALLED_COPY"
  as_root install -d /etc/skein
  printf 'user=%s\nhome=%s\nkde_only=%s\n' "$USER" "$HOME" "$KDE_ONLY" | as_root tee "$PENDING" >/dev/null
  as_root tee "$UNIT" >/dev/null <<UNITFILE
[Unit]
Description=Remove KDE Plasma (skein-remove-kde)
ConditionPathExists=$PENDING
Before=display-manager.service graphical.target

[Service]
Type=oneshot
ExecStart=$INSTALLED_COPY boot
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
UNITFILE
  as_root systemctl daemon-reload
  as_root systemctl enable skein-remove-kde.service
  log "KDE will be removed during the next boot, before the login screen (journalctl -u skein-remove-kde). Reboot when ready."
}

# what the unit runs, as root, before the login manager starts
cmd_boot() {
  [[ -f $PENDING ]] || exit 0
  local home
  home=$(sed -n 's/^home=//p' "$PENDING")
  KDE_ONLY=$(sed -n 's/^kde_only=//p' "$PENDING")
  # one try: whatever happens below, it never runs again
  rm -f "$PENDING"
  systemctl disable skein-remove-kde.service || true
  [[ -d $home ]] || die "home directory '$home' not found"
  YES=1
  TARGET_HOME="$home"
  cmd_remove
  cmd_clean
}

while (($#)); do
  case $1 in
  --yes) YES=1 ;;
  --kde-only) KDE_ONLY=1 ;;
  --home) shift; TARGET_HOME="$1" ;;
  schedule | remove | clean | status | list | boot) action=$1 ;;
  *) die "usage: skein-remove-kde [schedule|remove|clean|status|list] [--kde-only] [--yes] [--home DIR]" ;;
  esac
  shift
done

case "${action:-status}" in
schedule) cmd_schedule ;;
remove) cmd_remove ;;
clean) cmd_clean ;;
boot) cmd_boot ;;
status) cmd_status ;;
list) cmd_list ;;
esac
