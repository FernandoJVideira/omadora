#!/usr/bin/env bash
# The old name of skeinctl, kept so existing scripts and habits keep working. OMADORA_* variables
# still reach the new commands as SKEIN_*.
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
while IFS= read -r var; do
  new="SKEIN_${var#OMADORA_}"
  [[ -n ${!new+x} ]] || export "$new=${!var}"
done < <(compgen -e | grep '^OMADORA_' || true)
exec "$here/skeinctl" "$@"
