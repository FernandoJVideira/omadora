[Unit]
Description=Skein shell (Quickshell: bar, launcher, notifications, OSD, lock)
PartOf=skein-session.target
After=graphical-session.target
# Wants= from skein-session.target does not inherit its condition, so
# repeat it here to stop this from starting under non-Hyprland sessions.
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=/usr/bin/qs -c skein -n
Restart=on-failure
Slice=app-graphical.slice

[Install]
WantedBy=skein-session.target
