[Unit]
Description=Omadora Session Service
PartOf=omadora-session.target
After=graphical-session.target
# Wants= from omadora-session.target does not inherit its condition, so
# repeat it here to stop this from starting under non-Hyprland sessions.
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStart=%h/.local/share/omadora/libexec/systemd/omadora-session-start
ExecStop=%h/.local/share/omadora/libexec/systemd/omadora-session-stop

TimeoutStopSec=10

[Install]
WantedBy=omadora-session.target
